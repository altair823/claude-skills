#!/bin/sh
# Gitea release를 생성하고 자산을 업로드한다 (자동 sha256 + minisign 옵션).
#
# Usage:
#   gitea-release <TAG> [--name TITLE] [--notes TEXT | --notes-file PATH]
#                 [--draft] [--prerelease] [--target COMMITISH]
#                 [--asset PATH]... [--sign KEYPATH]
#                 [--auto-notes] [-r owner/repo] [-u URL]

set -eu
. "$(dirname "$0")/_common.sh"

prev_release_meta() {
    tea_api GET "/repos/{owner}/{repo}/releases?limit=2&draft=false&pre-release=false" \
        | jq -r '. | if length >= 2 then "\(.[1].tag_name)\t\(.[1].created_at)" else "" end'
}

build_pr_section() {
    prev_tag="$1"
    prev_created="$2"
    pulls_json="$(tea_api GET "/repos/{owner}/{repo}/pulls?state=closed&sort=updated&direction=desc&limit=50")"

    raw_count="$(printf '%s' "$pulls_json" | jq 'length')"
    if [ "$raw_count" = "50" ]; then
        printf '[gitea-release] 경고: pulls 응답 50건 도달 — 일부 PR이 노트에 누락 가능\n' >&2
    fi

    if [ -n "$prev_tag" ] && [ -n "$prev_created" ]; then
        filtered="$(printf '%s' "$pulls_json" \
            | jq --arg t "$prev_created" '[.[] | select(.merged == true and .merged_at != null and .merged_at > $t)]')"
        header="## 변경사항 (since $prev_tag)"
    else
        filtered="$(printf '%s' "$pulls_json" \
            | jq '[.[] | select(.merged == true)]')"
        header="## 변경사항 (initial release)"
    fi

    count="$(printf '%s' "$filtered" | jq 'length')"
    [ "$count" = "0" ] && { printf ''; return; }

    items="$(printf '%s' "$filtered" \
        | jq -r '.[] | "- #\(.number) \(.title | gsub("\n"; " "))"')"
    printf '%s\n\n%s\n' "$header" "$items"
}

TAG=""
NAME=""
NOTES=""
NOTES_FILE=""
DRAFT="false"
PRE="false"
TARGET=""
ASSETS=""   # newline-separated
SIGN_KEY=""
AUTO_NOTES="false"

while [ $# -gt 0 ]; do
    case "$1" in
        --name) NAME="$2"; shift 2 ;;
        --notes) NOTES="$2"; shift 2 ;;
        --notes-file) NOTES_FILE="$2"; shift 2 ;;
        --draft) DRAFT="true"; shift ;;
        --prerelease) PRE="true"; shift ;;
        --target) TARGET="$2"; shift 2 ;;
        --asset) ASSETS="$ASSETS$2
"; shift 2 ;;
        --sign) SIGN_KEY="$2"; shift 2 ;;
        --auto-notes) AUTO_NOTES="true"; shift ;;
        -r|--repo) GITEA_REPO="$2"; export GITEA_REPO; shift 2 ;;
        -u|--url) GITEA_URL="$2"; export GITEA_URL; shift 2 ;;
        -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
        -*) die "알 수 없는 flag: $1" ;;
        *)
            [ -z "$TAG" ] || die "예기치 않은 인자: $1"
            TAG="$1"; shift ;;
    esac
done

[ -n "$TAG" ] || die "TAG 인자 필요"
require_author_login
require_cmd sha256sum
[ -n "$SIGN_KEY" ] && require_cmd minisign
: "${NAME:=$TAG}"

if [ -z "$NOTES" ] && [ -n "$NOTES_FILE" ]; then
    NOTES="$(cat "$NOTES_FILE")"
fi

if [ "$AUTO_NOTES" = "true" ]; then
    meta="$(prev_release_meta)"
    prev_tag="$(printf '%s' "$meta" | cut -f1)"
    prev_created="$(printf '%s' "$meta" | cut -f2)"
    section="$(build_pr_section "$prev_tag" "$prev_created")"
    if [ -n "$section" ]; then
        if [ -n "$NOTES" ]; then
            NOTES="$section
$NOTES"
        else
            NOTES="$section"
        fi
    fi
fi

# Push tag if local-only — tea won't do this for us.
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null 2>&1; then
        if ! git ls-remote --tags origin "refs/tags/$TAG" | grep -q "$TAG"; then
            printf '[gitea-release] tag push: %s\n' "$TAG" >&2
            git push origin "$TAG"
        fi
    fi
fi

body_json="$(jq -cn \
    --arg tag "$TAG" \
    --arg name "$NAME" \
    --arg body "$NOTES" \
    --arg target "$TARGET" \
    --argjson draft "$DRAFT" \
    --argjson pre "$PRE" \
    '{tag_name:$tag, name:$name, body:$body, draft:$draft, prerelease:$pre}
     + (if $target != "" then {target_commitish:$target} else {} end)')"

resp="$(printf '%s' "$body_json" | tea_api_json POST "/repos/{owner}/{repo}/releases")"

rel_id="$(printf '%s' "$resp" | jq -r '.id // empty')"
html_url="$(printf '%s' "$resp" | jq -r '.html_url // empty')"
if [ -z "$rel_id" ] || [ "$rel_id" = "null" ]; then
    printf '[gitea-release] release 생성 실패:\n%s\n' "$resp" >&2
    exit 1
fi
printf '[gitea-release] release 생성 완료: id=%s url=%s\n' "$rel_id" "$html_url" >&2

# Upload assets: original + sha256 (always) + minisig (if --sign).
# Each asset uploaded individually so we can build the .sha256/.minisig
# alongside it without juggling parallel arrays. tea handles multipart.
if [ -n "$ASSETS" ]; then
    tmp_dir="$(mktemp -d -t gitea-release-XXXXXX)"
    trap 'rm -rf "$tmp_dir"' EXIT INT TERM

    upload_one() {
        f="$1"
        printf '[gitea-release] asset 업로드: %s\n' "$(basename "$f")" >&2
        if [ -n "${GITEA_REPO:-}" ]; then
            tea releases assets create "$TAG" "$f" \
                --login "$GITEA_LOGIN_AUTHOR" --repo "$GITEA_REPO" >/dev/null
        else
            tea releases assets create "$TAG" "$f" \
                --login "$GITEA_LOGIN_AUTHOR" >/dev/null
        fi
    }

    printf '%s' "$ASSETS" | while IFS= read -r asset; do
        [ -n "$asset" ] || continue
        [ -r "$asset" ] || die "asset 파일 없음: $asset"

        upload_one "$asset"

        sha_file="$tmp_dir/$(basename "$asset").sha256"
        (cd "$(dirname "$asset")" && sha256sum "$(basename "$asset")") > "$sha_file"
        upload_one "$sha_file"

        if [ -n "$SIGN_KEY" ]; then
            minisign -Sm "$asset" -s "$SIGN_KEY" >/dev/null 2>&1 \
                || die "minisign 서명 실패: $asset"
            upload_one "$asset.minisig"
        fi
    done
fi

printf '%s\n' "$html_url"
