#!/bin/sh
# Gitea PR에 reviewer token으로 review를 등록한다.
#
# Usage:
#   gitea-pr-review <PR#> --event <APPROVE|REQUEST_CHANGES|COMMENT>
#                          [--body "..." | --body -]
#                          [--inline FILE | --inline -]
#                          [-r owner/repo] [-u URL]
#
# --body 또는 --inline 중 하나 이상 필요 (둘 다 가능).
#
# Reviewer token은 $GITEA_REVIEWER_TOKEN env 또는 ~/.config/gitea-ops/reviewer-token 파일에서 로드.

set -eu
. "$(dirname "$0")/_common.sh"

PR=""
EVENT=""
BODY=""
BODY_FROM_STDIN="false"
INLINE_FILE=""
INLINE_FROM_STDIN="false"

while [ $# -gt 0 ]; do
    case "$1" in
        --event) EVENT="$2"; shift 2 ;;
        --body)
            if [ "$2" = "-" ]; then
                BODY_FROM_STDIN="true"
            else
                BODY="$2"
            fi
            shift 2 ;;
        --inline)
            if [ "$2" = "-" ]; then
                INLINE_FROM_STDIN="true"
            else
                INLINE_FILE="$2"
            fi
            shift 2 ;;
        -r|--repo) GITEA_REPO="$2"; export GITEA_REPO; shift 2 ;;
        -u|--url)  GITEA_URL="$2"; export GITEA_URL; shift 2 ;;
        -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
        -*) die "알 수 없는 flag: $1" ;;
        *)
            [ -z "$PR" ] || die "예기치 않은 인자: $1"
            PR="$1"; shift ;;
    esac
done

[ -n "$PR" ] || die "PR# 인자 필요"
[ -n "$EVENT" ] || die "--event 인자 필요"

case "$EVENT" in
    APPROVE)         API_EVENT="APPROVED" ;;
    REQUEST_CHANGES) API_EVENT="REQUEST_CHANGES" ;;
    COMMENT)         API_EVENT="COMMENT" ;;
    *) die "--event 값 오류: $EVENT (APPROVE|REQUEST_CHANGES|COMMENT 중 선택)" ;;
esac

if [ "$BODY_FROM_STDIN" = "true" ] && [ "$INLINE_FROM_STDIN" = "true" ]; then
    die "--body와 --inline 둘 다 stdin 사용 불가"
fi

if [ "$BODY_FROM_STDIN" = "true" ]; then
    BODY="$(cat)"
elif [ "$INLINE_FROM_STDIN" = "true" ]; then
    INLINE_JSON="$(cat)"
fi

if [ -z "$BODY" ] && [ -z "${INLINE_JSON:-}" ] && [ -z "$INLINE_FILE" ]; then
    die "--body 또는 --inline 중 하나 이상 필요"
fi

if [ -n "$INLINE_FILE" ]; then
    [ -r "$INLINE_FILE" ] || die "inline 파일 읽을 수 없음: $INLINE_FILE"
    INLINE_JSON="$(cat "$INLINE_FILE")"
fi

if [ -n "${INLINE_JSON:-}" ]; then
    if ! printf '%s' "$INLINE_JSON" | jq -e 'type == "array"' >/dev/null 2>&1; then
        die "inline JSON 오류: 배열 아님"
    fi
    bad="$(printf '%s' "$INLINE_JSON" | jq -r '
        [.[] |
         select((.path|type != "string") or
                (.body|type != "string") or
                ((.new_position|type) != "number" and (.old_position|type) != "number"))
        ] | length' 2>/dev/null || echo 1)"
    [ "$bad" = "0" ] || die "inline JSON 오류: 각 항목에 path/body/new_position 또는 old_position 필요"
fi

require_reviewer_login
TEA_LOGIN="$GITEA_LOGIN_REVIEWER"
export TEA_LOGIN

if [ -n "${INLINE_JSON:-}" ]; then
    body_json="$(jq -cn \
        --arg event "$API_EVENT" \
        --arg body "$BODY" \
        --argjson comments "$INLINE_JSON" \
        '{event:$event, body:$body, comments:$comments}')"
else
    body_json="$(jq -cn \
        --arg event "$API_EVENT" \
        --arg body "$BODY" \
        '{event:$event, body:$body}')"
fi

# tea api routes through the reviewer login (TEA_LOGIN exported above).
# Multi-byte UTF-8 safe — Go net/http sends the body bytes verbatim.
resp="$(printf '%s' "$body_json" | tea_api_json POST "/repos/{owner}/{repo}/pulls/$PR/reviews")"

err_msg="$(printf '%s' "$resp" | jq -r '.message // empty' 2>/dev/null || true)"
if [ -n "$err_msg" ]; then
    case "$err_msg" in
        *"own pull request"*|*"cannot review"*)
            die "self-review 불가: $err_msg" ;;
        *)
            die "review 등록 실패: $err_msg" ;;
    esac
fi

review_url="$(printf '%s' "$resp" | jq -r '.html_url // empty')"
if [ -z "$review_url" ]; then
    printf '[gitea-pr-review] 예기치 않은 응답:\n%s\n' "$resp" >&2
    exit 1
fi
printf '%s\n' "$review_url"
