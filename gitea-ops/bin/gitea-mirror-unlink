#!/bin/sh
# push mirror 등록 해제. GitHub repo 자체는 보존 (사용자가 직접 gh repo delete).
#
# Usage: gitea-mirror-unlink <mirror-name> [--gitea-repo owner/repo]
#
# <mirror-name> 은 gitea-mirror-ls 출력의 첫 컬럼 (Gitea 가 자동 생성한
# remote_name 값).

set -eu
. "$(dirname "$0")/_common.sh"

NAME=""
GITEA_REPO_OPT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --gitea-repo) GITEA_REPO_OPT="$2"; shift 2 ;;
        -h|--help)    sed -n '2,7p' "$0"; exit 0 ;;
        -*) die "알 수 없는 flag: $1" ;;
        *)
            [ -z "$NAME" ] || die "예기치 않은 인자: $1"
            NAME="$1"; shift ;;
    esac
done

[ -n "$NAME" ] || die "mirror-name 필수 (gitea-mirror-ls 로 확인)"

require_author_login
[ -n "$GITEA_REPO_OPT" ] && { GITEA_REPO="$GITEA_REPO_OPT"; export GITEA_REPO; }

tea_api DELETE "/repos/{owner}/{repo}/push_mirrors/$NAME" >/dev/null \
    || die "unlink 실패: $NAME"

printf '[gitea-mirror-unlink] %s 해제 완료\n' "$NAME" >&2
