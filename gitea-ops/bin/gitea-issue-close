#!/bin/sh
# Close a Gitea issue, optionally leaving a comment.
#
# Usage:
#   gitea-issue-close <NUMBER> [--comment "..."] [-r owner/repo] [-u URL]

set -eu
. "$(dirname "$0")/_common.sh"
require_cmd curl jq

NUM=""
COMMENT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --comment) COMMENT="$2"; shift 2 ;;
        -r|--repo) GITEA_REPO="$2"; shift 2 ;;
        -u|--url)  GITEA_URL="$2"; shift 2 ;;
        -h|--help) sed -n '2,6p' "$0"; exit 0 ;;
        -*) die "unknown flag: $1" ;;
        *)
            [ -z "$NUM" ] || die "unexpected positional: $1"
            NUM="$1"; shift ;;
    esac
done

[ -n "$NUM" ] || die "issue number required"
resolve_remote

if [ -n "$COMMENT" ]; then
    body="$(jq -n --arg body "$COMMENT" '{body:$body}')"
    printf '%s' "$body" \
        | api_json POST "/repos/$GITEA_REPO/issues/$NUM/comments" \
        >/dev/null
fi

resp="$(printf '%s' '{"state":"closed"}' | api_json PATCH "/repos/$GITEA_REPO/issues/$NUM")"
state="$(printf '%s' "$resp" | jq -r '.state // empty')"
if [ "$state" != "closed" ]; then
    printf '[gitea-issue-close] failed:\n%s\n' "$resp" >&2
    exit 1
fi
url="$(printf '%s' "$resp" | jq -r '.html_url // empty')"
printf '[gitea-issue-close] #%s closed  %s\n' "$NUM" "$url" >&2
printf '%s\n' "$url"
