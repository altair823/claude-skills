#!/bin/sh
# Gitea issue를 닫는다 (선택적으로 코멘트 추가).
#
# Usage:
#   gitea-issue-close <NUMBER> [--comment "..."] [-r owner/repo] [-u URL]

set -eu
. "$(dirname "$0")/_common.sh"

NUM=""
COMMENT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --comment) COMMENT="$2"; shift 2 ;;
        -r|--repo) GITEA_REPO="$2"; export GITEA_REPO; shift 2 ;;
        -u|--url)  GITEA_URL="$2"; export GITEA_URL; shift 2 ;;
        -h|--help) sed -n '2,5p' "$0"; exit 0 ;;
        -*) die "알 수 없는 flag: $1" ;;
        *)
            [ -z "$NUM" ] || die "예기치 않은 인자: $1"
            NUM="$1"; shift ;;
    esac
done

[ -n "$NUM" ] || die "issue number 인자 필요"
require_author_login

if [ -n "$COMMENT" ]; then
    body="$(jq -n --arg body "$COMMENT" '{body:$body}')"
    # tea api can return exit 0 with a `.message` field on 4xx — verify the
    # response so a failed comment doesn't silently slide into the close call.
    comment_resp="$(printf '%s' "$body" \
        | tea_api_json POST "/repos/{owner}/{repo}/issues/$NUM/comments")"
    comment_err="$(printf '%s' "$comment_resp" | jq -r '.message // empty' 2>/dev/null || true)"
    [ -z "$comment_err" ] || die "issue #$NUM 코멘트 실패: $comment_err"
fi

resp="$(printf '%s' '{"state":"closed"}' | tea_api_json PATCH "/repos/{owner}/{repo}/issues/$NUM")"
state="$(printf '%s' "$resp" | jq -r '.state // empty')"
if [ "$state" != "closed" ]; then
    printf '[gitea-issue-close] issue 닫기 실패:\n%s\n' "$resp" >&2
    exit 1
fi
url="$(printf '%s' "$resp" | jq -r '.html_url // empty')"
printf '[gitea-issue-close] #%s 닫음: %s\n' "$NUM" "$url" >&2
printf '%s\n' "$url"
