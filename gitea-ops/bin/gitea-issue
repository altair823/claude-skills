#!/bin/sh
# Gitea에 issue를 생성한다.
#
# Usage:
#   gitea-issue --title "..." [--body "..."] [--label LABEL]...
#               [--assignee USER]... [--milestone ID]
#               [-r owner/repo] [-u URL]

set -eu
. "$(dirname "$0")/_common.sh"
require_cmd curl jq

TITLE=""
BODY=""
ASSIGNEES_JSON="[]"
LABEL_NAMES=""  # we resolve names → IDs via /labels
MILESTONE=""

append_json_array() { echo "$1" | jq --arg v "$2" '. + [$v]' ; }

while [ $# -gt 0 ]; do
    case "$1" in
        --title)     TITLE="$2"; shift 2 ;;
        --body)      BODY="$2"; shift 2 ;;
        --label)     LABEL_NAMES="$LABEL_NAMES$2
"; shift 2 ;;
        --assignee)  ASSIGNEES_JSON="$(append_json_array "$ASSIGNEES_JSON" "$2")"; shift 2 ;;
        --milestone) MILESTONE="$2"; shift 2 ;;
        -r|--repo)   GITEA_REPO="$2"; shift 2 ;;
        -u|--url)    GITEA_URL="$2"; shift 2 ;;
        -h|--help)   sed -n '2,7p' "$0"; exit 0 ;;
        *) die "알 수 없는 인자: $1" ;;
    esac
done

[ -n "$TITLE" ] || die "--title 인자 필요"
resolve_remote

# Resolve label names to IDs
LABEL_IDS_JSON="[]"
if [ -n "$LABEL_NAMES" ]; then
    labels_resp="$(api GET "/repos/$GITEA_REPO/labels?page=1&limit=100")"
    LABEL_IDS_JSON="$(printf '%s' "$LABEL_NAMES" | awk 'NF' | jq -R -s --argjson all "$labels_resp" '
        split("\n") | map(select(length>0)) as $wanted
        | [ $all[] | select(.name as $n | $wanted | index($n)) | .id ]
    ')"
fi

body_args="--arg title \"\$TITLE\" --arg body \"\$BODY\""
milestone_arg=""
if [ -n "$MILESTONE" ]; then
    milestone_arg='| . + {milestone: '"$MILESTONE"'}'
fi

body_json="$(jq -n \
    --arg title "$TITLE" \
    --arg body "$BODY" \
    --argjson labels "$LABEL_IDS_JSON" \
    --argjson assignees "$ASSIGNEES_JSON" \
    '{title:$title, body:$body, labels:$labels, assignees:$assignees}' \
    | jq "$( [ -n "$MILESTONE" ] && printf '. + {milestone: %s}' "$MILESTONE" || printf '.' )")"

resp="$(printf '%s' "$body_json" | api_json POST "/repos/$GITEA_REPO/issues")"

num="$(printf '%s' "$resp" | jq -r '.number // empty')"
url="$(printf '%s' "$resp" | jq -r '.html_url // empty')"
if [ -z "$num" ]; then
    printf '[gitea-issue] issue 작성 실패:\n%s\n' "$resp" >&2
    exit 1
fi
printf '[gitea-issue] #%s 작성 완료: %s\n' "$num" "$url" >&2
printf '%s\n' "$url"
