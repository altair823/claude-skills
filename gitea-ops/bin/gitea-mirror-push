#!/bin/sh
# 일회성 git push — cron 동기화 없이 즉시 GitHub 으로 한 번 push.
# Gitea push mirror 등록과 무관 (그건 gitea-mirror-init).
#
# Usage:
#   gitea-mirror-push --gh-repo OWNER/NAME
#                     [--force-mirror]
#                     [--no-secret-scan] [--force-secret-scan]
#
# Default: `git push --all --tags` (로컬 branch + tag 만, force 없이).
# --force-mirror: `git push --mirror` (모든 ref + force-update + remote-tracking
#                 까지 포함). collaborator 직접 commit 손실 위험.
#
# cwd 가 git working copy 여야 한다. GitHub repo 가 이미 존재해야 한다 (없으면
# 먼저 `gh repo create` 또는 gitea-mirror-init).

set -eu
. "$(dirname "$0")/_common.sh"

GH_REPO=""
SECRET_SCAN="auto"
PUSH_MODE="branches"   # branches (--all --tags) | mirror (--mirror)

while [ $# -gt 0 ]; do
    case "$1" in
        --gh-repo) GH_REPO="$2"; shift 2 ;;
        --force-mirror)      PUSH_MODE="mirror"; shift ;;
        --no-secret-scan)    SECRET_SCAN="skip"; shift ;;
        --force-secret-scan) SECRET_SCAN="force"; shift ;;
        -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
        *) die "알 수 없는 인자: $1" ;;
    esac
done

[ -n "$GH_REPO" ] || die "--gh-repo 필수"
require_gh_auth
git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "cwd 가 git working copy 아님"

# GitHub repo visibility 조회 (없으면 die)
visibility="$(gh repo view "$GH_REPO" --json visibility --jq .visibility 2>/dev/null)" \
    || die "GitHub repo 조회 실패: $GH_REPO (없으면 gitea-mirror-init 먼저)"

if [ "$visibility" = "PUBLIC" ] && [ "$SECRET_SCAN" != "skip" ]; then
    scan_out="$(secret_scan_history)"
    if [ -z "$scan_out" ]; then
        printf '[gitea-mirror-push] secret scan: 0 hits\n' >&2
    else
        printf '[gitea-mirror-push] **secret scan: 의심 패턴 발견**\n%s\n' "$scan_out" >&2
        [ "$SECRET_SCAN" = "force" ] || die \
            "public push 보호: --no-secret-scan / --force-secret-scan 검토 후 재시도"
        printf '[gitea-mirror-push] --force-secret-scan: 사용자 승인으로 진행\n' >&2
    fi
fi

# git push — gh CLI 의 git credential helper (gh auth setup-git) 가 인증 처리.
gh_url="https://github.com/$GH_REPO.git"
if [ "$PUSH_MODE" = "mirror" ]; then
    printf '[gitea-mirror-push] git push --mirror to %s\n' "$GH_REPO" >&2
    printf '[gitea-mirror-push] **주의**: --force-mirror — GitHub 측 모든 ref (remote-tracking 포함) force-update. collaborator 직접 commit 손실 위험\n' >&2
    git push --mirror "$gh_url" \
        || die "git push --mirror 실패 — 'gh auth setup-git' 후 재시도"
else
    printf '[gitea-mirror-push] git push --all --tags to %s\n' "$GH_REPO" >&2
    # `--all --tags` 한 호출로 atomic — branches push 후 tags push 가 분리되면
    # 사이에서 실패 시 inconsistent (branches 만 push 된 상태) 가 됨.
    git push "$gh_url" --all --tags \
        || die "git push --all --tags 실패 — 'gh auth setup-git' 후 재시도. fast-forward 불가 시 --force-mirror 검토."
fi

printf 'https://github.com/%s\n' "$GH_REPO"
