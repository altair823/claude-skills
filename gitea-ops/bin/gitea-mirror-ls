#!/bin/sh
# 현재 Gitea repo 의 push mirrors 조회.
#
# Usage: gitea-mirror-ls [--gitea-repo owner/repo] [--json]

set -eu
. "$(dirname "$0")/_common.sh"

GITEA_REPO_OPT=""
JSON=0

while [ $# -gt 0 ]; do
    case "$1" in
        --gitea-repo) GITEA_REPO_OPT="$2"; shift 2 ;;
        --json)       JSON=1; shift ;;
        -h|--help)    sed -n '2,5p' "$0"; exit 0 ;;
        *) die "알 수 없는 인자: $1" ;;
    esac
done

require_author_login
[ -n "$GITEA_REPO_OPT" ] && { GITEA_REPO="$GITEA_REPO_OPT"; export GITEA_REPO; }

resp="$(tea_api GET "/repos/{owner}/{repo}/push_mirrors")"
err_msg="$(printf '%s' "$resp" | jq -r 'if type=="object" then .message // empty else empty end' 2>/dev/null || true)"
[ -z "$err_msg" ] || die "push mirror 조회 실패: $err_msg"

if [ "$JSON" = "1" ]; then
    printf '%s\n' "$resp"
else
    printf '%s' "$resp" | jq -r '
        if length == 0 then "(no push mirrors)"
        else .[] | "\(.remote_name)\t\(.remote_address)\tinterval=\(.interval)\tsync_on_commit=\(.sync_on_commit)\tlast_update=\(.last_update // "never")"
        end
    '
fi
