#!/usr/bin/env bash
# rd-shim — multiplexing shim.
#
# install.sh symlinks intercepted entrypoints (cargo, uv, make, cmake,
# go, npm, ...) to this file inside the shim dir. The shim dir is put
# FIRST on PATH, so `cargo build` run by anyone (you, an AI agent, a
# script) lands here and is transparently forwarded to rd-exec, which
# decides remote-vs-local. The caller never needs to know about remotedev.
set -eo pipefail

name="$(basename "$0")"
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
exec "$here/rd-exec" "$name" "$@"
