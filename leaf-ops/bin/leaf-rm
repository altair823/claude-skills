#!/usr/bin/env bash
# leaf-rm <사이트> [--yes]
#
# 사이트를 통째로 지운다. 파일 단위 삭제는 서버가 받지 않는다 — 덮어쓰면 된다.
. "$(dirname "$(readlink -f "$0")")/_common.sh"

SITE="${1:-}"; YES="${2:-}"
[ -n "$SITE" ] || { echo "사용법: leaf-rm <사이트> [--yes]" >&2; exit 2; }
case "$SITE" in -h|--help) echo "사용법: leaf-rm <사이트> [--yes]" >&2; exit 2;; esac
valid_site "$SITE" || die "사이트 이름이 올바르지 않습니다: $SITE"

# 발급된 토큰은 남의 사이트도 지울 수 있다. 대화형이면 한 번 묻는다.
if [ "$YES" != "--yes" ] && [ -t 0 ]; then
  read -rp "$SITE 를 지웁니다. 계속할까요? [y/N] " ok
  [ "$ok" = "y" ] || exit 1
fi

body=$(leaf_curl -X DELETE -w '\n%{http_code}' "$LEAF_URL/$SITE")
code="${body##*$'\n'}"; body="${body%$'\n'*}"
case "$code" in
  200) printf '%s' "$body";;
  401) die "인증 실패. LEAF_AUTH 를 확인하세요";;
  404) die "없는 사이트입니다: $SITE";;
  *)   die "삭제 실패($code)";;
esac
