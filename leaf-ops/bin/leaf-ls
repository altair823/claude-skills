#!/usr/bin/env bash
# leaf-ls [--json]
#
# 올라와 있는 사이트를 보여준다. 토큰 이름도 함께 나오지만 비밀값은 서버가
# 애초에 내보내지 않는다.
. "$(dirname "$(readlink -f "$0")")/_common.sh"

JSON=0
[ "${1:-}" = "--json" ] && JSON=1
[ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] && { echo "사용법: leaf-ls [--json]" >&2; exit 2; }

body=$(leaf_curl -w '\n%{http_code}' "$LEAF_URL/") || die "서버에 닿지 못했습니다: $LEAF_URL"
code="${body##*$'\n'}"; body="${body%$'\n'*}"
case "$code" in
  200) ;;
  401) die "인증 실패. LEAF_AUTH 를 확인하세요";;
  *)   die "목록 조회 실패($code)";;
esac

if [ "$JSON" = 1 ]; then
  printf '%s\n' "$body"
  exit 0
fi

command -v jq >/dev/null || { printf '%s\n' "$body"; exit 0; }

printf '%s' "$body" | jq -r '
  if (.sites | length) == 0 then "사이트 없음"
  else
    (["사이트","올린 주체","공개","삭제 예정"] | @tsv),
    (.sites[] | [
      .site,
      .owner,
      (if .public then "공개" else "비공개" end),
      (if .expires_in_days == null then "— (keep)" else "\(.expires_in_days)일 후" end)
    ] | @tsv)
  end' | column -t -s $'\t'

printf '\n토큰: %s\n' "$(printf '%s' "$body" | jq -r '[.tokens[].name] | join(", ")')"
