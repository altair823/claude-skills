#!/usr/bin/env bash
# leaf-put <파일|디렉토리> <사이트>[/경로] [--public] [--keep]
#
# 파일 하나면 그 경로에 올린다. 경로를 생략하면 index.html 로 올린다.
# 디렉토리면 그 안을 통째로 올린다(상대 경로 유지).
# 마지막에 사람에게 넘길 URL 한 줄을 찍는다.
. "$(dirname "$(readlink -f "$0")")/_common.sh"

usage() {
  cat >&2 <<'EOF'
사용법: leaf-put <파일|디렉토리> <사이트>[/경로] [--public] [--keep]

  leaf-put report.html 2026-08-report
      → https://.../2026-08-report/  (index.html 로 올라감)

  leaf-put chart.svg 2026-08-report/chart.svg
  leaf-put ./site handbook --keep --public

옵션
  --public   인증 없이 읽을 수 있게 한다
  --keep     30일 만료를 끈다 (기본은 마지막 업로드로부터 30일 뒤 삭제)

옵션을 생략하면 그 사이트의 기존 설정을 그대로 둔다. 빼도 공개나 영구가 풀리지 않는다.
EOF
  exit 2
}

SRC=""; DEST=""; HDRS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --public) HDRS+=(-H "X-Leaf-Public: true");;
    --keep)   HDRS+=(-H "X-Leaf-Keep: true");;
    -h|--help) usage;;
    -*) die "모르는 옵션: $1";;
    *) if [ -z "$SRC" ]; then SRC="$1"; elif [ -z "$DEST" ]; then DEST="$1"; else die "인자가 너무 많습니다"; fi;;
  esac
  shift
done
[ -n "$SRC" ] && [ -n "$DEST" ] || usage
[ -e "$SRC" ] || die "없는 경로: $SRC"

SITE="${DEST%%/*}"
SUB="${DEST#"$SITE"}"; SUB="${SUB#/}"
valid_site "$SITE" || die "사이트 이름은 소문자·숫자·-·_ 만 되고 64자까지입니다 (받은 값: $SITE)"

# 경로에 서버가 거부하는 문자가 있으면 여기서 잡는다. ASCII 안전 문자만.
check_path() {
  printf %s "$1" | grep -qE '^[A-Za-z0-9._/-]+$' \
    || die "경로에 못 쓰는 문자가 있습니다: $1 (A-Za-z0-9._- 와 / 만 됩니다)"
}

put_one() { # put_one <로컬파일> <사이트내경로>
  check_path "$2"
  local code
  code=$(leaf_curl -o /dev/null -w '%{http_code}' -T "$1" "${HDRS[@]+"${HDRS[@]}"}" "$LEAF_URL/$SITE/$2")
  case "$code" in
    200) ;;
    401) die "인증 실패. LEAF_AUTH 를 확인하세요";;
    413) die "파일이 32MB 상한을 넘습니다: $1";;
    *)   die "업로드 실패($code): $2";;
  esac
  # 헤더는 첫 파일에만 붙이면 된다. 사이트 단위 설정이라 반복이 무의미하다.
  HDRS=()
}

if [ -d "$SRC" ]; then
  BASE="${SUB:+$SUB/}"
  n=0
  while IFS= read -r f; do
    rel="${f#"$SRC"/}"
    put_one "$f" "$BASE$rel"
    n=$((n+1))
  done < <(find "$SRC" -type f | sort)
  [ "$n" -gt 0 ] || die "디렉토리에 파일이 없습니다: $SRC"
  echo "$n개 파일" >&2
  printf '%s/%s/%s\n' "$LEAF_URL" "$SITE" "$BASE"
else
  path="${SUB:-index.html}"
  put_one "$SRC" "$path"
  case "$path" in
    index.html) printf '%s/%s/\n' "$LEAF_URL" "$SITE";;
    *)          printf '%s/%s/%s\n' "$LEAF_URL" "$SITE" "$path";;
  esac
fi
