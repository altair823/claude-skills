#!/usr/bin/env bash
source "$(dirname "$0")/_lib.sh"
HERE="$(cd "$(dirname "$0")" && pwd)"

host_id="${1:-}"; sub="${2:-}"
[[ -n "$host_id" && -n "$sub" ]] || die "usage: pve <host-id> {api <METHOD> <path> [data] | status | vm-config <vmid> | action <verb> <target> [extra]}"

inv="$("$HERE/inv" get "$host_id")" || die "no such host: $host_id"
addr="$(jq -r '.address // empty' <<<"$inv")"
[[ -n "$addr" && "$addr" != "null" ]] || die "host $host_id has no address in inventory"
# 토큰은 bitwarden-ops bw-exec 가 PVE_TOKEN env 로 주입한다. homelab-ops 는
# bw 를 직접 다루지 않는다. 미주입 시 fail-closed(exit 3).
[[ -n "${PVE_TOKEN:-}" ]] || { HL_EXIT=3 die "missing PVE_TOKEN — bitwarden-ops bw-exec 로 감싸 실행 (참고: \"$HERE/guard\" --plan)"; }
token="$PVE_TOKEN"
base="https://${addr}:8006/api2/json"

# Per-host CA trust. A homelab Proxmox serves a self-signed cert from its
# built-in CA (named "PVE Cluster Manager CA" even on a standalone node), so
# system trust alone fails verification. inventory access.api.ca_path pins
# that CA via curl --cacert — verification stays ON (never -k/--insecure).
# Absent ca_path ⇒ fall back to system trust (unchanged default). A declared
# but unreadable CA fails CLOSED (never silently weaken TLS).
ca_path="$(jq -r '.access.api.ca_path // empty' <<<"$inv")"
ca_opt=()
if [[ -n "$ca_path" && "$ca_path" != "null" ]]; then
  [[ "$ca_path" == "~"* ]] && ca_path="${ca_path/#\~/$HOME}"
  [[ "$ca_path" != /* ]] && ca_path="$REPO_ROOT/$ca_path"
  [[ -r "$ca_path" ]] || die "ca_path not readable: $ca_path (host $host_id)"
  ca_opt=(--cacert "$ca_path")
fi

call() { # METHOD path [data]
  local m="$1" p="$2" d="${3:-}"
  # TLS verification ON (no -k / --insecure). --fail-with-body: HTTP >=400
  # yields a nonzero exit (so guard audits the real result) while still
  # printing the Proxmox error body. Token via header only.
  if [[ -n "$d" ]]; then
    curl -sS --fail-with-body ${ca_opt[@]+"${ca_opt[@]}"} -X "$m" \
      -H "Authorization: PVEAPIToken=${token}" --data "$d" "${base}${p}"
  else
    curl -sS --fail-with-body ${ca_opt[@]+"${ca_opt[@]}"} -X "$m" \
      -H "Authorization: PVEAPIToken=${token}" "${base}${p}"
  fi
}

case "$sub" in
  api)     call "${3:?METHOD}" "${4:?path}" "${5:-}" ;;
  status)  call GET "/nodes/${host_id}/status" ;;
  vm-config)
    vmid="${3:?vmid}"; call GET "/nodes/${host_id}/qemu/${vmid}/config" ;;
  action)
    verb="${3:?verb}"; tgt="${4:?target}"
    tinv="$("$HERE/inv" get "$tgt")" || die "pve: no such target: $tgt"
    tkind="$(jq -r '.kind' <<<"$tinv")"
    vmid="$(jq -r '.vmid // empty' <<<"$tinv")"
    case "$tkind" in
      vm)  api_kind=qemu ;;
      lxc) api_kind=lxc ;;
      *)   die "pve: target '$tgt' kind '$tkind' is not a qemu/lxc guest" ;;
    esac
    [[ -n "$vmid" ]] || die "pve: target '$tgt' has no vmid in inventory"
    case "$verb" in
      start)    call POST "/nodes/${host_id}/${api_kind}/${vmid}/status/start" ;;
      stop)     call POST "/nodes/${host_id}/${api_kind}/${vmid}/status/stop" ;;
      restart)  call POST "/nodes/${host_id}/${api_kind}/${vmid}/status/reboot" ;;
      snapshot) call POST "/nodes/${host_id}/${api_kind}/${vmid}/snapshot" "snapname=ho-$(date +%s)-$RANDOM" ;;
      destroy)  call DELETE "/nodes/${host_id}/${api_kind}/${vmid}" ;;
      *) die "pve: unknown action verb $verb" ;;
    esac ;;
  *) die "pve: unknown subcommand $sub" ;;
esac
