#!/usr/bin/env bash
# 순수 분류기: exec 의 동적 등급 단일 출처. 외부 의존 없음.
# 사용:
#   _classify <guest|node> -- <argv...>
#   _classify pve --method <M> --path <P> [--body ...]
# 출력(stdout): "<grade>\t<rule>"  grade ∈ {caution,destructive} (safe 없음)
set -euo pipefail
via="${1:?_classify: via required}"; shift

emit() { printf '%s\t%s\n' "$1" "$2"; exit 0; }

# 유효하지 않은 via 는 즉시 fail-closed (invalid-via)
case "$via" in
  guest|node|pve|kube) ;;
  *) emit destructive invalid-via ;;
esac

# kube transport: kubectl 첫 토큰(서브커맨드)을 기준으로 분류.
# 읽기 전용 서브커맨드 → caution, 변이/대화형 → destructive, 그 외 fail-closed.
# - kubectl 은 `--kubeconfig` 거부 가드를 bin/kube 가 별도 수행하므로 분류기는 토큰만 본다.
# - 셸 메타문자/래퍼는 kubectl argv 에 직접 흘러도 의미를 갖지 않으나(파일 인자/-l selector),
#   상위 exec 가 처리하는 metachar 가드는 여기선 적용하지 않는다 — kubectl 자체가 셸을
#   실행하지 않음. (실제 셸 분기는 kubectl exec/run/debug 가 컨테이너 내부에서 일으키므로
#   그쪽은 destructive 로 분류한다.)
if [[ "$via" == kube ]]; then
  [[ "${1:-}" == "--" ]] && shift || true
  [[ $# -gt 0 ]] || emit destructive fallback-deny
  case "$1" in
    # 읽기 전용 — 클러스터 상태/로그 조회. caution.
    get|describe|logs|top|cluster-info|version|explain|api-resources|api-versions|config|wait|diff|auth|events)
      emit caution "kube-ro:$1" ;;
    # 변이 — 리소스/스케일/롤아웃 조작. destructive.
    apply|create|delete|replace|patch|edit|scale|rollout|cordon|drain|uncordon|taint|annotate|label|set|expose|autoscale|run|exec|cp|port-forward|proxy|attach|debug|apply-set|apply-view-last-applied|delete-cluster|certificate)
      emit destructive "kube-write:$1" ;;
  esac
  # 미지/비분류 서브커맨드 → fail-closed
  emit destructive fallback-deny
fi

# pve transport: GET 만 caution, 그 외 destructive
if [[ "$via" == pve ]]; then
  method=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --method)
        # `shift 2` 가 아니라 명시 분기: --method 가 마지막 인자일 때
        # (`_classify pve --method`) `shift 2` 는 set -e 에서 over-shift 로
        # exit 1 + 빈 stdout 을 만든다 (guard 가 빈 줄을 받아 오등급).
        method="${2:-}"
        shift
        if [[ $# -gt 0 ]]; then shift; fi
        ;;
      *) shift ;;
    esac
  done
  case "$method" in
    GET) emit caution pve-get ;;
    *)   emit destructive pve-write ;;
  esac
fi

# guest/node: argv 는 '--' 다음
[[ "${1:-}" == "--" ]] && shift || true
[[ $# -gt 0 ]] || emit destructive fallback-deny

# 메타문자/셸 차단: 어떤 토큰이든 셸 체이닝·리다이렉트·치환·개행 포함,
# 또는 첫 토큰이 셸 인터프리터(-c 동반)면 destructive.
for tok in "$@"; do
  case "$tok" in
    *';'*|*'|'*|*'&'*|*'$'*|*'`'*|*'('*|*')'*|*'<'*|*'>'*|*$'\n'*)
      emit destructive metachar ;;
  esac
done
case "$1" in
  # 비-셸 인터프리터(python3 perl ruby 등)는 의도적으로 별도 처리 안 함: 어떤 allowlist에도
  # 없으므로 fail-closed 기본값이 잡아냄. 만약 나중에 allowlist에 추가한다면 -c/-e 반드시 가드.
  sh|bash|dash|zsh|ash) for a in "$@"; do [[ "$a" == "-c" ]] && emit destructive metachar; done ;;
esac

# 커맨드 래퍼 차단: env/sudo 등 wrapper를 통한 allowlist 우회 방지.
# 이 목록은 완전하지 않음(예: doas runuser chroot unshare nsenter). 완전성은 불필요 —
# fail-closed 기본값이 미지의 $1을 이미 destructive로 만듦. 이 가드는 OTHERWISE-ALLOWLISTED
# 결과를 세탁하는 경우를 막기 위해 존재.
case "$1" in
  env|sudo|su|xargs|nice|timeout|nohup|stdbuf|setsid)
    emit destructive wrapper ;;
esac

# read-only allowlist (첫 토큰 = 바이너리). 단순 바이너리는 인자 무관 caution.
# ip/ss/dmesg/journalctl 은 변이 플래그가 있어 별도 가드 블록에서 처리 (아래).
case "$1" in
  cat|ls|stat|df|du|lsblk|blkid|findmnt|free|uptime|hostname|id|whoami|date|uname|netstat|pvs|lvs|vgs)
    emit caution "ro-allowlist:$1" ;;
esac

# 변이 가능 바이너리: 읽기 전용 형태만 caution, 변이 인자 있으면 fall-through → fallback-deny

# journalctl: --flush/--rotate/--sync/--relinquish-var/--smart-relinquish-var/--vacuum* → mutating
if [[ "$1" == journalctl ]]; then
  _mutating=0
  for _a in "${@:2}"; do
    case "$_a" in
      --flush|--rotate|--sync|--relinquish-var|--smart-relinquish-var|--vacuum*)
        _mutating=1; break ;;
    esac
  done
  if [[ $_mutating -eq 0 ]]; then emit caution "ro-allowlist:journalctl"; fi
  # mutating → fall through to fallback-deny
fi

# dmesg: -C/--clear/-c/--read-clear → mutating
if [[ "$1" == dmesg ]]; then
  _mutating=0
  for _a in "${@:2}"; do
    case "$_a" in
      -C|--clear|-c|--read-clear) _mutating=1; break ;;
    esac
  done
  if [[ $_mutating -eq 0 ]]; then emit caution "ro-allowlist:dmesg"; fi
fi

# ss: -K/--kill → mutating
if [[ "$1" == ss ]]; then
  _mutating=0
  for _a in "${@:2}"; do
    case "$_a" in
      -K|--kill) _mutating=1; break ;;
    esac
  done
  if [[ $_mutating -eq 0 ]]; then emit caution "ro-allowlist:ss"; fi
fi

# ip: 변이 동사(add/del/delete/set/change/replace/flush/append/prepend) 없으면 caution
if [[ "$1" == ip ]]; then
  _mutating=0
  for _a in "${@:2}"; do
    case "$_a" in
      add|del|delete|set|change|replace|flush|append|prepend)
        _mutating=1; break ;;
    esac
  done
  if [[ $_mutating -eq 0 ]]; then emit caution "ro-allowlist:ip"; fi
fi
# 서브커맨드 한정 화이트리스트: <bin> <sub> 형태만 caution
sub="${2:-}"
case "$1 $sub" in
  "systemctl status"|"systemctl is-active"|"systemctl is-enabled"|"systemctl show"|"systemctl list-units")
    emit caution "ro-allowlist:systemctl-${sub}" ;;
  "qm config"|"qm list"|"qm status")
    emit caution "ro-allowlist:qm-${sub}" ;;
  "pct config"|"pct list"|"pct status")
    emit caution "ro-allowlist:pct-${sub}" ;;
  "pvesm status"|"pvesm list")
    emit caution "ro-allowlist:pvesm-${sub}" ;;
  "apt list"|"dpkg -l")
    emit caution "ro-allowlist:pkg-query" ;;
esac
# 그 외 전부 — 미지/비화이트리스트 → fail-closed
emit destructive fallback-deny
