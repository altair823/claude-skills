#!/usr/bin/env bash
# Real action dispatcher. Overridden by $HOMELAB_BACKEND in tests.
# Usage: _backend <action> <target-id> [--dry-run] -- <extra args...>
# SAFETY CONTRACT: under --dry-run this MUST NOT execute any mutating
# operation; it prints what WOULD happen and exits 0. guard relies on this
# so the destructive dry-run probe never actually runs the action.
source "$(dirname "$0")/_lib.sh"
HERE="$(dirname "$0")"
action="$1"; target="$2"; shift 2
dry=0
[[ "${1:-}" == "--dry-run" ]] && { dry=1; shift; }
[[ "${1:-}" == "--" ]] && shift || true

inv="$("$HERE/inv" get "$target")" || die "cannot resolve target: $target"
kind="$(jq -r .kind <<<"$inv")"

case "$action:$kind" in
  status:*|metrics:*|get:*)
    "$HERE/inv" resolve "$target" ;;
  # NOTE: 이 mutating action 목록은 _lib.sh op_transport 의 동명 arm 과 반드시
  # 함께 갱신해야 한다 (transport 결정의 단일 출처 — 둘이 어긋나면 오라우팅).
  # backup:* / pkg-install:* / provision:* 는 의도적으로 별도 arm 으로 분리되어 있으며,
  # 동일한 단일 출처 ACTIONS 테이블과 parity 테스트로 함께 커버된다.
  start:*|stop:*|restart:*|destroy:*|snapshot:*)
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would $action $target (kind=$kind)"; exit 0
    fi
    if [[ "$(op_transport "$action" "$kind")" == pve ]]; then
      "$HERE/pve" "$(owner_host "$target")" action "$action" "$target" "$@"
    else
      "$HERE/ssh-run" "$target" -- "$action" "$@"
    fi ;;
  backup:*)
    if [[ $dry -eq 1 ]]; then
      bvmid="$(jq -r '.vmid // "?"' <<<"$inv")"
      echo "DRY-RUN: would vzdump $target (vmid=$bvmid) storage=${1:-<none>} mode=${2:-snapshot} compress=${3:-zstd}"; exit 0
    fi
    "$HERE/pve" "$(owner_host "$target")" backup "$target" "$@" ;; # $@ = storage [mode] [compress] (→ pve backup sub $4/$5/$6)
  disk-attach:*|disk-detach:*)
    # 인자 파싱: --by-id <id> --index <N> --bus <bus(기본 scsi)>
    byid=""; idx=""; bus="scsi"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --by-id) byid="${2:?"disk-*: --by-id 에 값 필요"}"; shift 2 ;;
        --index) idx="${2:?"disk-*: --index 에 값 필요"}"; shift 2 ;;
        --bus)   bus="${2:?"disk-*: --bus 에 값 필요"}"; shift 2 ;;
        *) shift ;;
      esac
    done
    vmid="$(jq -r '.vmid // empty' <<<"$inv")"
    [[ -n "$vmid" ]] || die "disk-*: target '$target' has no vmid"
    if [[ "$action" == "disk-attach" ]]; then
      [[ "$byid" == /dev/disk/by-id/* ]] \
        || die "disk-attach: --by-id 는 /dev/disk/by-id/... 안정 경로만 허용 (받음: '${byid:-<none>}'). /dev/sdX 등 비안정 경로 거부."
      [[ "$byid" =~ ^/dev/disk/by-id/[A-Za-z0-9_.:-]+$ ]] \
        || die "disk-attach: --by-id 값에 허용되지 않는 문자 (안정 식별자 [A-Za-z0-9_.:-] 만; 경로탐색·셸 메타문자 거부)"
      # serial opt-in 강제: 인벤토리에 disks[].serial 선언이 없으면 거부.
      sercount="$(jq -r '[.disks[]?.serial | select(. != null)] | length' <<<"$inv")"
      [[ "$sercount" -ge 1 ]] \
        || die "disk-attach: 게스트 '$target' 인벤토리에 disks[].serial 미선언 — 명시적 opt-in 필요(아무 디스크나 패스스루 차단)"
      idx="${idx:-1}"
      [[ "$idx" =~ ^[0-9]+$ ]] || die "disk-*: --index 는 숫자여야 함 (받음: '${idx:-<none>}')"
      [[ "$bus" =~ ^[a-z]+$ ]] || die "disk-*: --bus 는 소문자 알파벳만 (예: scsi, virtio, ide)"
      cmd="qm set $vmid -${bus}${idx} ${byid},backup=0,iothread=1"
    else
      [[ -n "$idx" ]] || die "disk-detach: --index <N> 필요"
      [[ "$idx" =~ ^[0-9]+$ ]] || die "disk-*: --index 는 숫자여야 함 (받음: '${idx:-<none>}')"
      [[ "$bus" =~ ^[a-z]+$ ]] || die "disk-*: --bus 는 소문자 알파벳만 (예: scsi, virtio, ide)"
      cmd="qm set $vmid -delete ${bus}${idx}"
    fi
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would (on $(owner_host "$target")) $cmd"
      [[ "$action" == "disk-attach" ]] && echo "  serial 대조: 적용 시 노드 by-id 실측 serial 을 인벤토리 declared 와 대조(불일치 거부)"
      exit 0
    fi
    if [[ "$action" == "disk-attach" ]]; then
      # 적용 전 serial 실대조: owner 노드에서 by-id 장치의 실제 serial 을
      # 조회(byid 는 charset 검증 완료 → argv 안전) 후 인벤토리 declared
      # serial 집합과 비교. 불일치 시 qm set 전에 거부.
      _oh="$(owner_host "$target")"
      _declared="$(jq -r '[.disks[]?.serial | select(. != null)] | join(" ")' <<<"$inv")"
      # 노드 by-id 장치의 serial 을 JSON 으로 조회(-ndo 컬럼 절단 회피).
      # ssh-run||true 를 그룹화해 파이프라인 전체가 set-e 안전함을 명시.
      _lsj="$( { "$HERE/ssh-run" "$_oh" -- lsblk -J -o SERIAL "$byid" 2>/dev/null || true; } )"
      _actual="$(jq -r 'first(.blockdevices[]?.serial // empty)' <<<"$_lsj" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ -n "$_actual" ]] || die "disk-attach: 노드 '$_oh' 에서 by-id '$byid' 의 serial 조회 실패(장치 부재/lsblk 무응답) — 패스스루 거부"
      # _actual 는 노드 응답(neutral trust). case 패턴 측만 glob; "$_actual" 는 리터럴 치환이라 rogue '*' 도 fail-closed(매칭 실패→die). 공백경계 " $x " 로 부분일치 차단.
      case " $_declared " in
        *" $_actual "*) : ;;  # 인벤토리 declared 와 일치
        *) die "disk-attach: serial 불일치 — 노드 실측 '$_actual' 가 인벤토리 declared [$_declared] 에 없음. 패스스루 거부." ;;
      esac
      # TOCTOU 주의: serial 조회와 qm set 은 별 ssh 세션 — 그 사이 장치 교체는 미탐(원격 작업 본질적 한계, best-effort).
      "$HERE/ssh-run" "$_oh" -- qm set "$vmid" "-${bus}${idx}" "${byid},backup=0,iothread=1"
    else
      "$HERE/ssh-run" "$(owner_host "$target")" -- qm set "$vmid" -delete "${bus}${idx}"
    fi ;;
  disk-grow:*)
    lv=""
    while [[ $# -gt 0 ]]; do
      case "$1" in --lv) lv="${2:-}"; shift 2 ;; *) shift ;; esac
    done
    vmid="$(jq -r '.vmid // empty' <<<"$inv")"
    [[ -n "$vmid" ]] || die "disk-grow: target '$target' has no vmid"
    [[ "$vmid" =~ ^[0-9]+$ ]] || die "disk-grow: vmid 비정상"
    oh="$(owner_host "$target")"
    _ga() { # <remote shell cmd> -> guest-exec out-data, die if exitcode!=0/agent down
      local raw od ec
      raw="$("$HERE/ssh-run" "$oh" -- "qm guest exec $vmid -- $*" 2>&1)" \
        || die "disk-grow: qm guest exec 실패(게스트 guest-agent 미동작?): $raw"
      ec="$(jq -r '.exitcode // 1' <<<"$raw" 2>/dev/null || echo 1)"
      [[ "$ec" == "0" ]] || die "disk-grow: 게스트 명령 비-0 (exitcode=$ec): $*"
      od="$(jq -r '."out-data" // ""' <<<"$raw" 2>/dev/null || echo "")"
      printf '%s' "$od"
    }
    # 탐지 (read-only, dry/apply 공통)
    fm="$(_ga findmnt -J)"
    fstype="$(jq -r '.filesystems[]? | select(.target=="/") | .fstype' <<<"$fm" 2>/dev/null | head -n1)"
    mnt="/"
    rpt="$(_ga pvs --reportformat json; true)"
    lvline="$(_ga lvs --reportformat json)"
    if [[ -z "$lv" ]]; then
      lv="$(jq -r '[.report[]?.lv[]?] | if length==1 then (.[0]|.vg_name+"/"+.lv_name) else "" end' <<<"$lvline" 2>/dev/null)"
      [[ -n "$lv" ]] || die "disk-grow: 단일 LV 자동탐지 실패(다중/비표준) — --lv <vg/lv> 명시 필요"
    fi
    # charset guard: lv (operator-supplied 및 자동탐지 모두 적용) — dry+apply 공통
    [[ "$lv" =~ ^[A-Za-z0-9_+./-]+$ ]] || die "disk-grow: --lv/탐지된 LV 에 허용되지 않는 문자 (vg/lv 형식만)"
    case "$fstype" in
      ext4) fscmd="resize2fs /dev/${lv}" ;;
      xfs)  fscmd="xfs_growfs ${mnt}" ;;
      *)    die "disk-grow: 미지원 FS '$fstype' (ext4/xfs 만 지원)" ;;
    esac
    pvname="$(jq -r '[.report[]?.pv[]?.pv_name]|.[0]//""' <<<"$rpt" 2>/dev/null)"
    pvname="${pvname:-/dev/sda3}"
    disk="$(echo "$pvname" | sed -E 's#([0-9]+)$##')"
    partnum="$(echo "$pvname" | sed -E 's#.*[^0-9]([0-9]+)$#\1#')"
    seq1="growpart ${disk} ${partnum}"
    seq2="pvresize ${pvname}"
    seq3="lvextend -l +100%FREE ${lv}"
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: disk-grow $target (vmid=$vmid via $oh, guest-agent)"
      echo "  주의: PVE 레벨 가상디스크 확장은 본 verb 범위 밖(게스트 내부 전용) — PVE 디스크는 사전 확장 전제"
      echo "  탐지: PV=$pvname LV=$lv FS=$fstype mnt=$mnt"
      echo "  시퀀스: $seq1 && $seq2 && $seq3 && $fscmd"
      exit 0
    fi
    _ga $seq1 >/dev/null
    _ga $seq2 >/dev/null
    _ga $seq3 >/dev/null
    _ga $fscmd >/dev/null
    echo "GROWN: $target $lv ($fstype) extended on $oh" ;;
  pkg-install:*)
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would apt-get install on $target: ${*:-<none>}"; exit 0
    fi
    "$HERE/ssh-run" "$target" -- sudo apt-get install -y "$@" ;;
  provision:*)
    if [[ $dry -eq 1 ]]; then
      "$REPO_ROOT/provisioning/phase1" dry-run "$target" "$@"
    else
      "$REPO_ROOT/provisioning/phase1" apply "$target" "$@"
    fi ;;
  *)
    die "no backend mapping for action '$action' on kind '$kind'" ;;
esac
