#!/usr/bin/env bash
# Real action dispatcher. Overridden by $HOMELAB_BACKEND in tests.
# Usage: _backend <action> <target-id> [--dry-run] -- <extra args...>
# SAFETY CONTRACT: under --dry-run this MUST NOT execute any mutating
# operation; it prints what WOULD happen and exits 0. guard relies on this
# so the destructive dry-run probe never actually runs the action.
source "$(dirname "$0")/_lib.sh"
HERE="$(dirname "$0")"
action="$1"; target="$2"; shift 2
dry=0
[[ "${1:-}" == "--dry-run" ]] && { dry=1; shift; }
[[ "${1:-}" == "--" ]] && shift || true

inv="$("$HERE/inv" get "$target")" || die "cannot resolve target: $target"
kind="$(jq -r .kind <<<"$inv")"

case "$action:$kind" in
  status:*|metrics:*|get:*)
    "$HERE/inv" resolve "$target" ;;
  # NOTE: 이 mutating action 목록은 _lib.sh op_transport 의 동명 arm 과 반드시
  # 함께 갱신해야 한다 (transport 결정의 단일 출처 — 둘이 어긋나면 오라우팅).
  # backup:* / pkg-install:* / provision:* 는 의도적으로 별도 arm 으로 분리되어 있으며,
  # 동일한 단일 출처 ACTIONS 테이블과 parity 테스트로 함께 커버된다.
  start:*|stop:*|restart:*|destroy:*|snapshot:*)
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would $action $target (kind=$kind)"; exit 0
    fi
    if [[ "$(op_transport "$action" "$kind")" == pve ]]; then
      "$HERE/pve" "$(owner_host "$target")" action "$action" "$target" "$@"
    else
      "$HERE/ssh-run" "$target" -- "$action" "$@"
    fi ;;
  backup:*)
    if [[ $dry -eq 1 ]]; then
      bvmid="$(jq -r '.vmid // "?"' <<<"$inv")"
      echo "DRY-RUN: would vzdump $target (vmid=$bvmid) storage=${1:-<none>} mode=${2:-snapshot} compress=${3:-zstd}"; exit 0
    fi
    "$HERE/pve" "$(owner_host "$target")" backup "$target" "$@" ;; # $@ = storage [mode] [compress] (→ pve backup sub $4/$5/$6)
  disk-attach:*|disk-detach:*)
    # 인자 파싱: --by-id <id> --index <N> --bus <bus(기본 scsi)>
    byid=""; idx=""; bus="scsi"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --by-id) byid="${2:?"disk-*: --by-id 에 값 필요"}"; shift 2 ;;
        --index) idx="${2:?"disk-*: --index 에 값 필요"}"; shift 2 ;;
        --bus)   bus="${2:?"disk-*: --bus 에 값 필요"}"; shift 2 ;;
        *) shift ;;
      esac
    done
    vmid="$(jq -r '.vmid // empty' <<<"$inv")"
    [[ -n "$vmid" ]] || die "disk-*: target '$target' has no vmid"
    [[ "$vmid" =~ ^[0-9]+$ ]] || die "disk-*: vmid 비정상 (숫자만; 받음: '$vmid')"
    if [[ "$action" == "disk-attach" ]]; then
      [[ "$byid" == /dev/disk/by-id/* ]] \
        || die "disk-attach: --by-id 는 /dev/disk/by-id/... 안정 경로만 허용 (받음: '${byid:-<none>}'). /dev/sdX 등 비안정 경로 거부."
      [[ "$byid" =~ ^/dev/disk/by-id/[A-Za-z0-9_.:-]+$ ]] \
        || die "disk-attach: --by-id 값에 허용되지 않는 문자 (안정 식별자 [A-Za-z0-9_.:-] 만; 경로탐색·셸 메타문자 거부)"
      # serial opt-in 강제: 인벤토리에 disks[].serial 선언이 없으면 거부.
      sercount="$(jq -r '[.disks[]?.serial | select(. != null)] | length' <<<"$inv")"
      [[ "$sercount" -ge 1 ]] \
        || die "disk-attach: 게스트 '$target' 인벤토리에 disks[].serial 미선언 — 명시적 opt-in 필요(아무 디스크나 패스스루 차단)"
      idx="${idx:-1}"
      [[ "$idx" =~ ^[0-9]+$ ]] || die "disk-*: --index 는 숫자여야 함 (받음: '${idx:-<none>}')"
      [[ "$bus" =~ ^[a-z]+$ ]] || die "disk-*: --bus 는 소문자 알파벳만 (예: scsi, virtio, ide)"
      cmd="qm set $vmid -${bus}${idx} ${byid},backup=0,iothread=1"
    else
      [[ -n "$idx" ]] || die "disk-detach: --index <N> 필요"
      [[ "$idx" =~ ^[0-9]+$ ]] || die "disk-*: --index 는 숫자여야 함 (받음: '${idx:-<none>}')"
      [[ "$bus" =~ ^[a-z]+$ ]] || die "disk-*: --bus 는 소문자 알파벳만 (예: scsi, virtio, ide)"
      cmd="qm set $vmid -delete ${bus}${idx}"
    fi
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would (on $(owner_host "$target")) $cmd"
      [[ "$action" == "disk-attach" ]] && echo "  serial 대조: 적용 시 노드 by-id 실측 serial 을 인벤토리 declared 와 대조(불일치 거부)"
      exit 0
    fi
    if [[ "$action" == "disk-attach" ]]; then
      # 적용 전 serial 실대조: owner 노드에서 by-id 장치의 실제 serial 을
      # 조회(byid 는 charset 검증 완료 → argv 안전) 후 인벤토리 declared
      # serial 집합과 비교. 불일치 시 qm set 전에 거부.
      _oh="$(owner_host "$target")"
      _declared="$(jq -r '[.disks[]?.serial | select(. != null)] | join(" ")' <<<"$inv")"
      # 노드 by-id 장치의 serial 을 JSON 으로 조회(-ndo 컬럼 절단 회피).
      # ssh-run||true 를 그룹화해 파이프라인 전체가 set-e 안전함을 명시.
      _lsj="$( { "$HERE/ssh-run" "$_oh" -- lsblk -J -o SERIAL "$byid" 2>/dev/null || true; } )"
      _actual="$(jq -r 'first(.blockdevices[]?.serial // empty)' <<<"$_lsj" 2>/dev/null | tr -d '[:space:]' || true)"
      [[ -n "$_actual" ]] || die "disk-attach: 노드 '$_oh' 에서 by-id '$byid' 의 serial 조회 실패(장치 부재/lsblk 무응답) — 패스스루 거부"
      # _actual 는 노드 응답(neutral trust). case 패턴 측만 glob; "$_actual" 는 리터럴 치환이라 rogue '*' 도 fail-closed(매칭 실패→die). 공백경계 " $x " 로 부분일치 차단.
      case " $_declared " in
        *" $_actual "*) : ;;  # 인벤토리 declared 와 일치
        *) die "disk-attach: serial 불일치 — 노드 실측 '$_actual' 가 인벤토리 declared [$_declared] 에 없음. 패스스루 거부." ;;
      esac
      # TOCTOU 주의: serial 조회와 qm set 은 별 ssh 세션 — 그 사이 장치 교체는 미탐(원격 작업 본질적 한계, best-effort).
      "$HERE/ssh-run" "$_oh" -- qm set "$vmid" "-${bus}${idx}" "${byid},backup=0,iothread=1"
    else
      "$HERE/ssh-run" "$(owner_host "$target")" -- qm set "$vmid" -delete "${bus}${idx}"
    fi ;;
  disk-grow:*)
    lv=""; to=""; disksel=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lv)   lv="${2:-}"; shift 2 ;;
        --to)   to="${2:-}"; shift 2 ;;
        --disk) disksel="${2:-}"; shift 2 ;;
        *) shift ;;
      esac
    done
    vmid="$(jq -r '.vmid // empty' <<<"$inv")"
    [[ -n "$vmid" ]] || die "disk-grow: target '$target' has no vmid"
    [[ "$vmid" =~ ^[0-9]+$ ]] || die "disk-grow: vmid 비정상"
    oh="$(owner_host "$target")"
    # --to 처리: 크기 검증 + 디스크 탐지/지정 (read-only, dry/apply 공통)
    if [[ -n "$to" ]]; then
      [[ "$to" =~ ^[0-9]+[GT]$ ]] \
        || die "disk-grow --to: 크기 형식 [0-9]+(G|T) 만 (받음: '$to')"
      if [[ -n "$disksel" ]]; then
        [[ "$disksel" =~ ^(scsi|virtio|sata|ide)[0-9]+$ ]] \
          || die "disk-grow --disk: 유효하지 않은 디스크 식별자 (scsi|virtio|sata|ide)[0-9]+ 형식만 (받음: '$disksel')"
      else
        # owner 노드에서 qm config 읽기(read-only)로 단일 디스크 자동탐지
        # 주의: grep 패턴은 cdrom(ide2: ...,media=cdrom)·cloudinit 행도 매칭함 —
        # 의도적 비필터링(fail-closed): growable 디스크가 모호하면 operator 가 --disk 로 명시.
        qmcfg="$("$HERE/ssh-run" "$oh" -- qm config "$vmid" 2>&1)" \
          || die "disk-grow --to: qm config 조회 실패: $qmcfg"
        mapfile -t disklines < <(grep -E '^(scsi|virtio|sata|ide)[0-9]+:' <<<"$qmcfg" || true)
        if [[ "${#disklines[@]}" -eq 1 ]]; then
          disksel="${disklines[0]%%:*}"
        else
          die "disk-grow --to: 디스크 단일 자동탐지 실패 (${#disklines[@]}개 검출) — --disk <scsi0|...> 명시 필요 (cdrom/cloudinit 포함 가능 — growable 디스크를 --disk <scsiN> 로 명시)"
        fi
      fi
    fi
    _ga() { # <argv...> -> guest-exec out-data, die if exitcode!=0/agent down
      local raw od ec
      raw="$("$HERE/ssh-run" "$oh" -- qm guest exec "$vmid" -- "$@" 2>&1)" \
        || die "disk-grow: qm guest exec 실패(게스트 guest-agent 미동작?): $raw"
      ec="$(jq -r '.exitcode // 1' <<<"$raw" 2>/dev/null || echo 1)"
      [[ "$ec" == "0" ]] || die "disk-grow: 게스트 명령 비-0 (exitcode=$ec): $*"
      od="$(jq -r '."out-data" // ""' <<<"$raw" 2>/dev/null || echo "")"
      printf '%s' "$od"
    }
    # 탐지 (read-only, dry/apply 공통)
    fm="$(_ga findmnt -J)"
    fstype="$(jq -r '.filesystems[]? | select(.target=="/") | .fstype' <<<"$fm" 2>/dev/null | head -n1)"
    mnt="/"
    rpt="$(_ga pvs --reportformat json)"
    lvline="$(_ga lvs --reportformat json)"
    if [[ -z "$lv" ]]; then
      lv="$(jq -r '[.report[]?.lv[]?] | if length==1 then (.[0]|.vg_name+"/"+.lv_name) else "" end' <<<"$lvline" 2>/dev/null)"
      [[ -n "$lv" ]] || die "disk-grow: 단일 LV 자동탐지 실패(다중/비표준) — --lv <vg/lv> 명시 필요"
    fi
    # charset guard: lv (operator-supplied 및 자동탐지 모두 적용) — dry+apply 공통
    [[ "$lv" =~ ^[A-Za-z0-9_+./-]+$ ]] || die "disk-grow: --lv/탐지된 LV 에 허용되지 않는 문자 (vg/lv 형식만)"
    pvname="$(jq -r '[.report[]?.pv[]?.pv_name]|.[0]//""' <<<"$rpt" 2>/dev/null)"
    [[ -n "$pvname" ]] || die "disk-grow: pvs 가 PV 를 반환하지 않음(LVM 부재/탐지 실패) — 패스스루 거부"
    # pvname charset guard (defense-in-depth): /dev/... 장치 경로만 허용
    [[ "$pvname" =~ ^/dev/[A-Za-z0-9/_-]+$ ]] \
      || die "disk-grow: pvs 응답 pvname '${pvname}' 에 허용되지 않는 문자 (/dev/... 장치 경로만)"
    # nvme/mmcblk(pN suffix) vs sda/vdb(trailing digits) 구분 파티션 추출
    if [[ "$pvname" =~ p([0-9]+)$ ]]; then            # nvme0n1p2 / mmcblk0p3
      partnum="${BASH_REMATCH[1]}"; disk="${pvname%p${partnum}}"
    elif [[ "$pvname" =~ ([0-9]+)$ ]]; then            # sda3 / vdb1
      partnum="${BASH_REMATCH[1]}"; disk="${pvname%${partnum}}"
    else
      die "disk-grow: pvname '${pvname}' 에서 파티션 번호 추출 실패"
    fi
    case "$fstype" in
      ext4) fscmd="resize2fs /dev/${lv}" ;;
      xfs)  fscmd="xfs_growfs ${mnt}" ;;
      *)    die "disk-grow: 미지원 FS '$fstype' (ext4/xfs 만 지원)" ;;
    esac
    seq1="growpart ${disk} ${partnum}"
    seq2="pvresize ${pvname}"
    seq3="lvextend -l +100%FREE ${lv}"
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: disk-grow $target (vmid=$vmid via $oh, guest-agent)"
      if [[ -n "$to" ]]; then
        echo "  1단계(PVE): qm resize $vmid $disksel $to  ← owner 노드($oh) 에서 실행 (절대크기, 증가만; 축소는 PVE 거부)"
        echo "  주의: PVE 가상디스크 확장은 위 1단계(qm resize)로 수행됨 — 이어서 게스트 내부 확장 진행"
      else
        echo "  주의: PVE 레벨 가상디스크 확장은 본 verb 범위 밖(게스트 내부 전용) — PVE 디스크는 사전 확장 전제"
      fi
      echo "  탐지: PV=$pvname LV=$lv FS=$fstype mnt=$mnt"
      echo "  시퀀스: $seq1 && $seq2 && $seq3 && $fscmd"
      exit 0
    fi
    # apply: --to 지정 시 PVE 레벨 qm resize 선행
    if [[ -n "$to" ]]; then
      "$HERE/ssh-run" "$oh" -- qm resize "$vmid" "$disksel" "$to" \
        || die "disk-grow --to: qm resize $vmid $disksel $to 실패 (PVE 거부 — 크기 축소·VM 잠금·스토리지 부족·권한 등; 위 ssh 오류 확인)"
    fi
    _ga growpart "$disk" "$partnum" >/dev/null
    _ga pvresize "$pvname" >/dev/null
    _ga lvextend -l +100%FREE "$lv" >/dev/null
    if [[ "$fstype" == "ext4" ]]; then
      _ga resize2fs "/dev/${lv}" >/dev/null
    else
      _ga xfs_growfs "$mnt" >/dev/null
    fi
    echo "GROWN: $target $lv ($fstype) extended on $oh" ;;
  remote-migrate:*)
    to=""; tstor=""; tbridge=""; tvmid=""; online=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --to) to="${2:?"remote-migrate: --to 에 값 필요"}"; shift 2 ;;
        --target-storage) tstor="${2:?"remote-migrate: --target-storage 에 값 필요"}"; shift 2 ;;
        --target-bridge) tbridge="${2:?"remote-migrate: --target-bridge 에 값 필요"}"; shift 2 ;;
        --target-vmid) tvmid="${2:?"remote-migrate: --target-vmid 에 값 필요"}"; shift 2 ;;
        --online) online=1; shift ;;
        *) shift ;;
      esac
    done
    vmid="$(jq -r '.vmid // empty' <<<"$inv")"
    [[ -n "$vmid" ]] || die "remote-migrate: target '$target' has no vmid"
    [[ "$vmid" =~ ^[0-9]+$ ]] || die "remote-migrate: vmid 비정상"
    [[ -n "$to" ]] || die "remote-migrate: --to <target-node> 필요"
    # SANCTIONED charset 가드(Task5/7 정합): to/tstor/tbridge/tvmid 가 PDM API body 로 흘러
    # & = $ 공백 파라미터 인젝션을 차단.
    [[ "$to" =~ ^[A-Za-z0-9_.-]+$ ]] \
      || die "remote-migrate: --to '$to' 에 허용되지 않는 문자 (노드명 [A-Za-z0-9_.-] 만)"
    [[ -z "$tstor" || "$tstor" =~ ^[A-Za-z0-9_.:,/-]+$ ]] \
      || die "remote-migrate: --target-storage '$tstor' 에 허용되지 않는 문자 (src:dst[,src2:dst2] 형식만)"
    [[ -z "$tbridge" || "$tbridge" =~ ^[A-Za-z0-9_.:,/-]+$ ]] \
      || die "remote-migrate: --target-bridge '$tbridge' 에 허용되지 않는 문자 (src:dst[,src2:dst2] 형식만)"
    [[ -z "$tvmid" || "$tvmid" =~ ^[0-9]+$ ]] \
      || die "remote-migrate: --target-vmid '$tvmid' 는 숫자만 허용"
    src="$(owner_host "$target")"
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: remote-migrate $target vmid=$vmid src=$src to=$to storage=${tstor:-<same>} bridge=${tbridge:-<same>} target-vmid=${tvmid:-<same>} online=$([[ $online -eq 1 ]] && echo true || echo false)"
      echo "  (PDM 경유; 실 PDM API path 는 인벤토리 access.api.migrate_path 로 확정 — spec §5)"
      exit 0
    fi
    "$HERE/pdm" remote-migrate "$vmid" "$to" "$tstor" "$online" "$src" "$tbridge" "$tvmid" ;;
  pkg-install:*)
    if [[ $dry -eq 1 ]]; then
      echo "DRY-RUN: would apt-get install on $target: ${*:-<none>}"; exit 0
    fi
    "$HERE/ssh-run" "$target" -- sudo apt-get install -y "$@" ;;
  service:*)
    svc_sub="${1:-}"; svc_unit="${2:-}"
    case "$svc_sub" in start|stop|restart|status) : ;; *) die "service: 서브커맨드는 start|stop|restart|status (받음: '$svc_sub')" ;; esac
    [[ "$svc_unit" =~ ^[A-Za-z0-9_.@:-]+$ ]] || die "service: unit 명 charset 위반 (받음: '$svc_unit')"
    if [[ $dry -eq 1 ]]; then echo "DRY-RUN: service $svc_sub $svc_unit on $target (guest ssh)"; exit 0; fi
    "$HERE/ssh-run" "$target" -- systemctl "$svc_sub" "$svc_unit" ;;
  logs:*)
    lg_unit=""; lg_file=""; lg_n="100"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --unit) lg_unit="${2:-}"; shift 2 ;;
        --file) lg_file="${2:-}"; shift 2 ;;
        -n)     lg_n="${2:-}";    shift 2 ;;
        *)      shift ;;
      esac
    done
    [[ "$lg_n" =~ ^[0-9]+$ ]] || die "logs: -n 은 정수 (받음: '$lg_n')"
    if [[ -n "$lg_unit" ]]; then
      [[ "$lg_unit" =~ ^[A-Za-z0-9_.@:-]+$ ]] || die "logs: --unit charset 위반"
      if [[ $dry -eq 1 ]]; then echo "DRY-RUN: logs journalctl -u $lg_unit -n $lg_n on $target"; exit 0; fi
      "$HERE/ssh-run" "$target" -- journalctl -u "$lg_unit" -n "$lg_n" --no-pager
    elif [[ -n "$lg_file" ]]; then
      [[ "$lg_file" =~ ^/[A-Za-z0-9_./-]+$ ]] || die "logs: --file 은 절대경로·안전문자만"
      [[ "$lg_file" != *..* ]] || die "logs: --file 에 '..' 경로 구성요소 불가"
      if [[ $dry -eq 1 ]]; then echo "DRY-RUN: logs tail -n $lg_n $lg_file on $target"; exit 0; fi
      "$HERE/ssh-run" "$target" -- tail -n "$lg_n" "$lg_file"
    else die "logs: --unit <u> 또는 --file <path> 필요"; fi ;;
  pkg-update:*)
    if [[ $dry -eq 1 ]]; then echo "DRY-RUN: pkg-update (apt/dnf update+upgrade) on $target (guest ssh)"; exit 0; fi
    # 내부에서 구성한 신뢰 명령(운영자 임의 입력 아님) — exec 분류기 metachar 규칙과 무관
    "$HERE/ssh-run" "$target" -- sh -lc 'if command -v apt-get >/dev/null; then DEBIAN_FRONTEND=noninteractive apt-get update && DEBIAN_FRONTEND=noninteractive apt-get -y upgrade; else dnf -y upgrade; fi' ;;
  reboot:*)
    # 알려진 한계: systemctl reboot 은 SSH 연결을 즉시 끊으므로 ssh-run 이 비-0(예: 255)으로
    # 종료될 수 있다 — 게스트가 실제로 재부팅에 성공해도 감사 로그에 비-0 exit 이 기록됨.
    if [[ $dry -eq 1 ]]; then echo "DRY-RUN: reboot guest OS on $target (systemctl reboot via guest ssh)"; exit 0; fi
    "$HERE/ssh-run" "$target" -- systemctl reboot ;;
  provision:*)
    if [[ $dry -eq 1 ]]; then
      "$REPO_ROOT/provisioning/phase1" dry-run "$target" "$@"
    else
      "$REPO_ROOT/provisioning/phase1" apply "$target" "$@"
    fi ;;
  kubectl:*)
    [[ "$kind" == "k8s-cluster" ]] \
      || die "kubectl: target '$target' is kind '$kind' (need k8s-cluster)"
    if [[ $dry -eq 1 ]]; then
      # 표시 전용: 사람이 읽는 한 줄 메시지 — 실 실행 경로는 ${@} 로 argv-safe 전달.
      echo "DRY-RUN: kubectl $target -- ${*:-<no args>}"; exit 0
    fi
    "$HERE/kube" "$target" -- "$@" ;;
  exec:*)
    via=""; cargs=()
    # 1패스: --via 를 추출하고 --method/--path/--body 를 포함한 나머지 인자를
    # 모두 cargs 로 정규화. cargs 는 표시(dry-run 메시지)·라우팅·pve 재파싱의
    # 단일 정규 페이로드로, 세 경로 모두 이 배열을 출처로 삼는다.
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --via) via="${2:?exec: --via 에 값 필요}"; shift 2 ;;
        --method) cargs+=(--method "${2:?exec: --method 에 값 필요}"); shift 2 ;;
        --path)   cargs+=(--path   "${2:?exec: --path 에 값 필요}");   shift 2 ;;
        --body)   cargs+=(--body   "${2:?exec: --body 에 값 필요}");   shift 2 ;;
        --) shift; cargs+=("$@"); break ;;
        *) cargs+=("$1"); shift ;;
      esac
    done
    [[ "$via" =~ ^(guest|node|pve)$ ]] || die "exec: --via 는 guest|node|pve 중 하나여야 합니다 (받음: '${via:-<none>}')"
    if [[ $dry -eq 1 ]]; then
      # 표시 전용: 사람이 읽는 한 줄 메시지라 의도적으로 ${cargs[*]} 사용.
      # 실 실행 경로(아래 case)는 모두 ${cargs[@]} 로 argv-safe 전달.
      echo "DRY-RUN: exec $target via=$via ${cargs[*]+"${cargs[*]}"}"; exit 0
    fi
    case "$via" in
      guest) "$HERE/ssh-run" "$target" -- "${cargs[@]+"${cargs[@]}"}" ;;
      node)  "$HERE/ssh-run" "$(owner_host "$target")" -- "${cargs[@]+"${cargs[@]}"}" ;;
      pve)
        method=""; path=""; body=()
        # 2패스: pve 브랜치는 cargs(단일 정규 페이로드)를 재파싱해 --method/--path/--body
        # 를 추출. cargs 가 단일 출처이므로 1패스에서 정규화된 인자가 일관되게 흘러온다.
        # nounset 안전 관용구: cargs 가 비어 있을 때 "${arr[@]}" 참조를 차단.
        set -- "${cargs[@]+"${cargs[@]}"}"
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --method) method="${2:?exec pve: --method 에 값 필요}"; shift 2 ;;
            --path)   path="${2:?exec pve: --path 에 값 필요}";     shift 2 ;;
            --body)   body+=("${2:?exec pve: --body 에 값 필요}"); shift 2 ;;
            *) shift ;;
          esac
        done
        [[ -n "$method" ]] || die "exec pve: --method 필요"
        [[ -n "$path"   ]] || die "exec pve: --path 필요"
        "$HERE/pve" "$(owner_host "$target")" api "$method" "$path" "${body[@]+"${body[@]}"}" ;;
    esac ;;
  *)
    die "no backend mapping for action '$action' on kind '$kind'" ;;
esac
