#!/usr/bin/env bash
source "$(dirname "$0")/_lib.sh"
HERE="$(cd "$(dirname "$0")" && pwd)"

_bump() { case "$1" in safe) echo caution;; caution) echo destructive;; *) echo destructive;; esac; }

# grade <action> <target-id> -> prints safe|caution|destructive
guard_grade() {
  local action="${1:-}" target="${2:-}" g tj jrc=0
  [[ -n "$action" && -n "$target" ]] || die "usage: guard grade <action> <target-id>"
  g="$(action_grade "$action")"                # deny-by-default (단일 테이블)
  tj="$("$HERE/inv" get "$target")" || exit $?  # inv already prints a specific error
  jq -e '(.tags? // []) | index("critical")' >/dev/null 2>&1 <<<"$tj" || jrc=$?
  [[ $jrc -eq 5 ]] && die "cannot parse inventory JSON for target: $target"
  # critical escalates one grade (rule #4) — but ONLY for ops that can mutate.
  # safe is inherently read-only (status/metrics/get/list/inventory); escalating
  # it would gate observability of critical hosts behind --approve, which
  # inverts the rule's intent ("destructive mistakes must be hard", not "you
  # cannot look at a critical host"). So safe is never bumped.
  [[ $jrc -eq 0 && "$g" != "safe" ]] && g="$(_bump "$g")"
  echo "$g"
}

case "${1:-}" in
  grade)
    [[ $# -ge 3 ]] || die "usage: guard grade <action> <target-id>"
    guard_grade "$2" "$3" ;;
  "")
    die "usage: guard <action> <target-id> [--approve] [-- <extra>...]" ;;
  --plan)
    # read-only: inventory 만 읽어 op 가 필요로 하는 NAME=bw://ref 를 출력.
    # 어떤 시크릿에도 접근하지 않는다 (safe).
    [[ $# -ge 3 ]] || die "usage: guard --plan <action> <target-id>"
    pa="$2"; pt="$3"
    pgrade="$(guard_grade "$pa" "$pt")"        # target 존재도 검증; 없으면 die
    pinv="$("$HERE/inv" get "$pt")" || exit $?
    pkind="$(jq -r '.kind // ""' <<<"$pinv")"
    ptrans="$(op_transport "$pa" "$pkind")"
    # safe + transport=none (status/metrics/get/list/inventory): 자격 불필요.
    # safe + transport!=none (verify-specs 등): credential 산출 진행 — 아래 케이스.
    [[ "$pgrade" == "safe" && "$ptrans" == "none" ]] && exit 0
    # exec: --via 로 실제 transport 결정
    if [[ "$pa" == "exec" ]]; then
      shift 3 2>/dev/null || true
      [[ "${1:-}" == "--" ]] && shift || true
      pvia=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --via) pvia="${2:-}"; shift 2 ;;
          *) shift ;;
        esac
      done
      case "$pvia" in
        # Critical 1 fix: guest always means direct SSH to the guest (ssh-run).
        # The old kind-dispatch (vm/lxc→pve, else→ssh) diverged from _backend's
        # exec:guest arm which unconditionally calls ssh-run. Both plan and
        # runtime now agree: guest → ssh transport (HL_SSH_KEY).
        guest) ptrans=ssh ;;
        node)  ptrans=host-ssh ;;
        pve)   ptrans=pve ;;
        *) die "--plan exec: --via guest|node|pve 필요" ;;
      esac
    fi
    case "$ptrans" in
      pve)
        pref="$("$HERE/inv" get "$(owner_host "$pt")" \
                | jq -r '.access.api.token_ref // empty')"
        [[ -n "$pref" ]] && printf 'PVE_TOKEN=%s\n' "$pref" ;;
      ssh)
        pauth="$(jq -r '.access.ssh.auth // "key"' <<<"$pinv")"
        if [[ "$pauth" == "password" ]]; then
          pref="$(jq -r '.access.ssh.pass_ref // empty' <<<"$pinv")"
          [[ -n "$pref" ]] && printf 'HL_SSH_PASS=%s\n' "$pref"
        else
          pref="$(jq -r '.access.ssh.key_ref // empty' <<<"$pinv")"
          [[ -n "$pref" ]] && printf 'HL_SSH_KEY=%s\n' "$pref"
        fi ;;
      host-ssh)
        # Important 1 fix: orphan guard — if owner_host falls back to the target
        # itself (no Proxmox host claims it as a child), --via node is nonsensical
        # and would silently emit the guest's own key. Die explicitly.
        _powner="$(owner_host "$pt")"
        # 이 --plan host-ssh 가지는 exec --via node 외에 비-exec host-ssh verb
        # (disk-attach/detach/grow)도 도달 가능. orphan 거부는 양쪽 모두에서 안전한
        # 정책(고아 게스트에 host-ssh 시도는 호출자 의도와 무관하게 잘못된 키 사용).
        [[ "$_powner" == "$pt" ]] && die "host-ssh op '$pa': target '$pt' has no owning Proxmox host in inventory (orphan)"
        pho="$("$HERE/inv" get "$_powner")" || exit $?
        phauth="$(jq -r '.access.ssh.auth // "key"' <<<"$pho")"
        if [[ "$phauth" == "password" ]]; then
          pref="$(jq -r '.access.ssh.pass_ref // empty' <<<"$pho")"
          [[ -n "$pref" ]] && printf 'HL_SSH_PASS=%s\n' "$pref"
        else
          pref="$(jq -r '.access.ssh.key_ref // empty' <<<"$pho")"
          [[ -n "$pref" ]] && printf 'HL_SSH_KEY=%s\n' "$pref"
        fi ;;
      pdm)
        pref="$("$HERE/inv" get "$(pdm_entry)" \
                | jq -r '.access.api.token_ref // empty')"
        [[ -n "$pref" ]] && printf 'PDM_TOKEN=%s\n' "$pref" ;;
      kube)
        # k8s-cluster 엔트리 검증 + kubeconfig ref 추출.
        pkind_cluster="$(jq -r '.kind // ""' <<<"$pinv")"
        [[ "$pkind_cluster" == "k8s-cluster" ]] \
          || die "--plan kubectl: target '$pt' is kind '$pkind_cluster' (need k8s-cluster)"
        pref="$(jq -r '.access.kubeconfig.ref // empty' <<<"$pinv")"
        [[ -n "$pref" ]] || die "--plan kubectl: target '$pt' has no access.kubeconfig.ref"
        printf 'HL_KUBECONFIG=%s\n' "$pref" ;;
      none)
        # status|metrics|get 은 정당한 무자격 read-only. 그 외(deny-default
        # destructive 로 등급된 미매핑 액션)는 stdout 계약을 더럽히지 않도록
        # stderr 로만 모호성을 알린다.
        case "$pa" in
          status|metrics|get) : ;;
          *) echo "homelab-ops: --plan: '$pa' 는 transport 매핑이 없어 credential 을 산출하지 못함 (미지원 액션일 수 있음)" >&2 ;;
        esac ;;
    esac
    exit 0 ;;
  *)
    action="$1"; target="${2:-}"
    [[ -n "$target" ]] || die "usage: guard <action> <target-id> [--approve] [-- <extra>...]"
    shift 2
    orig_action="$action"
    action="$(canon_action "$action")"   # 별칭(delete→destroy) 정규화: 등급·경로·감사 일관
    approve=0; extra=(); gov=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --approve) approve=1; shift ;;
        --grade-override) gov="${2:?--grade-override 값 필요}"; shift 2 ;;
        --) shift; extra=("$@"); break ;;
        *) extra+=("$1"); shift ;;
      esac
    done

    op="$(new_op_id)"
    start_ms=$(date +%s%3N)
    grade="unknown"; env_t="unknown"; tags_t="[]"
    inv_json="null"; approver="null"; approved_at="null"; dryrun_hash="null"
    task_upid=""; task_xs=""
    # Critical 2: init exec-specific vars BEFORE trap install so EXIT trap can
    # reference them safely under set -u even on early-die paths (e.g. unknown target).
    EXEC_VIA=""; EXEC_GRADE=""; EXEC_RULE=""

    _audit() { # <exit-code>
      local end_ms; end_ms=$(date +%s%3N)
      # exec 전용 추가 인자·필터 — non-exec 는 둘 다 빈 채로 단일 호출로 진행.
      # _xfilter 는 jq 변수 참조($via 등)를 담으므로 단일 인용('), shell 확장 없음.
      local _xargs=() _xfilter=''
      if [[ "$action" == "exec" || "$action" == "kubectl" ]]; then
        _xargs=(--arg via "$EXEC_VIA" --arg cg "$EXEC_GRADE" --arg cr "$EXEC_RULE")
        # Important 2 fix: mirror task_upid/task_exitstatus convention — empty
        # string (early-die exec path) becomes JSON null, not "".
        _xfilter=',via:($via|if .=="" then null else . end),classify_grade:($cg|if .=="" then null else . end),classify_rule:($cr|if .=="" then null else . end)'
      fi
      # set -u 안전 배열 확장: _xargs 가 비어 있을 때 빈 배열을 "${arr[@]}" 로
      # 참조하면 unbound variable 오류가 발생하므로 "${arr[@]+"${arr[@]}"}" 관용구 사용.
      audit_append \
        --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg session "$HOMELAB_SESSION_ID" --arg op "$op" \
        --arg actor "claude" --arg action "$action" --arg target "$target" \
        --arg grade "$grade" --arg env "$env_t" \
        --argjson tags "$tags_t" --argjson inv "$inv_json" \
        --arg dh "$dryrun_hash" --arg apr "$approver" --arg apat "$approved_at" \
        --arg tu "$task_upid" --arg tx "$task_xs" \
        --argjson ex "$1" --argjson dur "$((end_ms-start_ms))" \
        "${_xargs[@]+"${_xargs[@]}"}" \
        '{ts:$ts,session:$session,op:$op,actor:$actor,action:$action,
         target:$target,grade:$grade,env:$env,tags:$tags,inv_snapshot:$inv,
         dryrun_hash:$dh,approver:$apr,approved_at:$apat,exit:$ex,duration_ms:$dur,
         task_upid:($tu|if .=="" then null else . end),
         task_exitstatus:($tx|if .=="" then null else . end)'"${_xfilter}"'}'
    }
    # Forensic guarantee (spec §6): ANY termination — normal, preflight failure,
    # backend failure, OR operator interrupt (Ctrl-C / SIGTERM) — writes exactly
    # one audit record (never a gap, never a double, never a false exit:0). An
    # audit-write failure is surfaced to stderr, never silently swallowed.
    _finish_trap() { # <exit-code>
      local _frc="$1"
      if [[ -z "${_DONE:-}" ]]; then
        # best-effort: 인터럽트 등으로 정상 경로의 HO-TASK 파싱이 실행되지
        # 않았어도, run-log 에서 task_upid 를 복구해 감사 정확성을 높인다.
        # 우선순위 1: HO-TASK 라인 / 2: raw {"data":"UPID:..."}(PVE) /
        # 3: raw {"data":"<task-id>"}(PVE 외 transport, 예: PDM).
        # 실패해도 감사 1건 보장(Rule 5)을 절대 훼손하지 않는다(|| true).
        if [[ -z "$task_upid" && -n "${rl:-}" && -f "${rl:-/nonexistent}" ]]; then
          task_upid="$(sed -n 's/^HO-TASK upid=\([^ ]*\).*/\1/p' "$rl" 2>/dev/null | tail -n1 || true)"
          task_xs="$(sed -n 's/^HO-TASK .*exitstatus=\(.*\)$/\1/p' "$rl" 2>/dev/null | tail -n1 || true)"
          if [[ -z "$task_upid" ]]; then
            task_upid="$(grep -o 'UPID:[^"]*' "$rl" 2>/dev/null | tail -n1 || true)"
          fi
          if [[ -z "$task_upid" ]]; then
            # PVE 외 transport(PDM 등): bin/pdm/bin/pve 가 출력한 raw
            # {"data":"<task-id>"} 응답에서 task id 복구(PVE UPID 비포함 형식).
            task_upid="$(grep -oE '"data"[[:space:]]*:[[:space:]]*"[^"]+"' "$rl" 2>/dev/null | tail -n1 | sed -E 's/.*"data"[[:space:]]*:[[:space:]]*"([^"]+)"/\1/' || true)"
          fi
        fi
        _DONE=1
        _audit "$_frc" || echo "homelab-ops: AUDIT FAILED op=$op rc=$_frc" >&2
      fi
      [[ -n "${_rc_file:-}" ]] && rm -f "$_rc_file" 2>/dev/null || true
    }
    trap '_rc=$?; _finish_trap "$_rc"; exit "$_rc"' EXIT
    trap '_finish_trap 130; trap - EXIT INT TERM; exit 130' INT
    trap '_finish_trap 143; trap - EXIT INT TERM; exit 143' TERM

    { _inv_tmp="$("$HERE/inv" get "$target")" && inv_json="$_inv_tmp"; } || die "cannot resolve target: $target"
    env_t="$(jq -r '.env // "unknown"' <<<"$inv_json")"
    tags_t="$(jq -rc '.tags // []' <<<"$inv_json")"

    # 동적 등급(exec/kubectl): _classify 로 런타임 위임. 그 외 액션에서 gov 는 불허.
    if [[ "$action" == "exec" || "$action" == "kubectl" ]]; then
      via=""; cargs=()
      # nounset 안전 방어: extra 가 미정의일 때도 빈 배열로 처리.
      set -- "${extra[@]+"${extra[@]}"}"
      if [[ "$action" == "kubectl" ]]; then
        # kubectl: --via 인자 없음(kube 고정). extra 전체가 kubectl argv.
        via="kube"
        cargs=("$@")
        [[ "${#cargs[@]}" -gt 0 ]] || die "kubectl: 실행할 kubectl 인자가 없습니다"
      else
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --via) via="${2:?exec: --via <guest|node|pve> 필요}"; shift 2 ;;
            --) shift; cargs=("$@"); break ;;
            *) cargs+=("$1"); shift ;;
          esac
        done
        [[ "$via" =~ ^(guest|node|pve)$ ]] || die "exec: --via 는 guest|node|pve 중 하나여야 합니다"
        [[ "${#cargs[@]}" -gt 0 ]] || die "exec: 실행할 명령이 없습니다 (--via 뒤에 명령을 지정하세요)"
      fi
      if [[ "$via" == "pve" ]]; then
        cls="$("$HERE/_classify" pve "${cargs[@]+"${cargs[@]}"}")"
      else
        cls="$("$HERE/_classify" "$via" -- "${cargs[@]+"${cargs[@]}"}")"
      fi
      # _classify 출력 형식: grade<TAB>rule — tab 구분자로 분리.
      cgrade="${cls%%$'\t'*}"; crule="${cls##*$'\t'}"
      if [[ -n "$gov" ]]; then
        case "$gov" in
          destructive) cgrade=destructive; crule="${crule}+override" ;;
          *) die "$action: --grade-override 는 상향(destructive)만 허용 (받음: $gov)" ;;
        esac
      fi
      EXEC_VIA="$via"; EXEC_GRADE="$cgrade"; EXEC_RULE="$crule"
    else
      [[ -n "$gov" ]] && die "--grade-override 는 exec/kubectl 전용"
    fi

    if [[ "$action" == "exec" || "$action" == "kubectl" ]]; then
      grade="$EXEC_GRADE"
      # Reuse already-fetched inv_json (line ~168) — avoids TOCTOU divergence
      # between audit snapshot and critical-bump decision (IMPORTANT 1 fix).
      _ejrc=0
      jq -e '(.tags? // []) | index("critical")' >/dev/null 2>&1 <<<"$inv_json" || _ejrc=$?
      [[ $_ejrc -eq 5 ]] && die "cannot parse inventory JSON for target: $target"
      [[ $_ejrc -eq 0 && "$grade" != "safe" ]] && grade="$(_bump "$grade")"
    else
      grade="$(guard_grade "$action" "$target")"
    fi

    rl="$(run_log_path "$op")"
    backend="${HOMELAB_BACKEND:-$HERE/_backend}"

    # Credential gate: transport != none 이면 그 transport 의 credential env 가
    # 있어야 한다 — grade 와 무관(safe pve 인 verify-specs 도 PVE_TOKEN 필요).
    # transport == none(safe none: status/metrics/get — _backend 는 inv resolve
    # 만 함)은 시크릿 불필요로 통과. credential 은 bitwarden-ops bw-exec 가 주입
    # (homelab-ops 는 bw 를 모른다).
    _t="$(op_transport "$action" "$(jq -r '.kind // ""' <<<"$inv_json")")"
    # exec 는 transport 가 dynamic — --via 로 실제 transport 결정.
    # kubectl 은 정적 transport(kube) — op_transport 가 이미 "kube" 를 반환하므로 별도 매핑 불필요.
    if [[ "$action" == "exec" ]]; then
      case "$EXEC_VIA" in
        # Critical 1 fix: guest always means direct guest SSH (ssh-run), not
        # kind-dispatch. Matches _backend exec:guest arm and --plan fix above.
        guest) _t=ssh ;;
        node)  _t=host-ssh ;;
        pve)   _t=pve ;;
      esac
    fi
    _auth="$(jq -r '.access.ssh.auth // "key"' <<<"$inv_json")"
    # host-ssh: 자격 대상이 owner_host(target). pdm: kind:pdm 엔트리.
    if [[ "$_t" == "host-ssh" ]]; then
      # Important 1 fix: exec --via node on an orphan target silently emits the
      # guest's own SSH key (owner_host falls back to $target); die explicitly.
      # Scoped to exec only: non-exec host-ssh ops (disk-attach/detach/grow) use
      # the conservative fallback ({} → _auth=key) intentionally — they may have
      # a different owner resolution path in _backend. Consistent with --plan scope.
      if [[ "$action" == "exec" ]]; then
        _rowner="$(owner_host "$target")"
        [[ "$_rowner" == "$target" ]] && die "exec --via node: target '$target' has no owning Proxmox host in inventory (orphan)"
        _hoinv="$("$HERE/inv" get "$_rowner" 2>/dev/null || echo '{}')"
      else
        _hoinv="$("$HERE/inv" get "$(owner_host "$target")" 2>/dev/null || echo '{}')"
      fi
      _auth="$(jq -r '.access.ssh.auth // "key"' <<<"$_hoinv")"
    fi
    if [[ "$_t" != "none" ]]; then
      _gate_var=""
      [[ "$_t" == "pve" && -z "${PVE_TOKEN:-}" ]] && _gate_var="PVE_TOKEN"
      [[ "$_t" == "pdm" && -z "${PDM_TOKEN:-}" ]] && _gate_var="PDM_TOKEN"
      [[ "$_t" == "kube" && -z "${HL_KUBECONFIG:-}" ]] && _gate_var="HL_KUBECONFIG"
      if [[ "$_t" == "ssh" || "$_t" == "host-ssh" ]]; then
        if [[ "$_auth" == "password" ]]; then
          [[ -z "${HL_SSH_PASS:-}" ]] && _gate_var="HL_SSH_PASS"
        else
          [[ -z "${HL_SSH_KEY:-}" ]] && _gate_var="HL_SSH_KEY"
        fi
      fi
      if [[ -n "$_gate_var" ]]; then
        _DONE=1; _audit 3 || echo "homelab-ops: AUDIT FAILED op=$op rc=3" >&2
        HL_EXIT=3 die "missing $_gate_var — bitwarden-ops bw-exec 로 감싸 실행하세요: bw-exec \"\$('$HERE/guard' --plan $action $target)\" -- '$HERE/guard' $action $target"
      fi
    fi

    needs_approval=0
    [[ "$grade" == "destructive" ]] && needs_approval=1
    [[ "$grade" == "caution" && "$env_t" == "prod" ]] && needs_approval=1

    if [[ "$grade" == "caution" ]]; then
      echo "SUMMARY: [$grade] $action $target (env=$env_t tags=$tags_t)"
    fi

    if [[ "$needs_approval" -eq 1 ]]; then
      dry="$("$backend" "$action" "$target" --dry-run -- ${extra[@]+"${extra[@]}"} 2>&1 || true)"
      dryrun_hash="$(printf '%s' "$dry" | sha256sum | awk '{print $1}')"
      if [[ "$approve" -ne 1 ]]; then
        echo "DRY-RUN [$grade] $action $target (env=$env_t tags=$tags_t)"
        { [[ "$action" == "exec" || "$action" == "kubectl" ]] && [[ -n "$EXEC_RULE" ]]; } && echo "classify_rule: $EXEC_RULE"
        echo "$dry" | mask
        echo "Impact above. Re-run with --approve to execute."
        _DONE=1; _audit 10 || echo "homelab-ops: AUDIT FAILED op=$op rc=10" >&2
        trap - EXIT INT TERM; exit 10
      fi
      approver="claude+user"; approved_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    fi

    # Pre-op state snapshot → run log (best-effort, masked, never blocks).
    {
      echo "=== pre-op snapshot $(date -u +%FT%TZ) op=$op action=$orig_action(→$action) ==="
      "$HERE/inv" resolve "$target" 2>/dev/null || true
      "$backend" status "$target" -- 2>/dev/null || true
      echo "=== action output ==="
    } | mask > "$rl"

    # Run the action pipeline in background so that INT/TERM signals can
    # interrupt `wait` (bash defers traps while waiting for a foreground
    # pipeline). sed -u makes the mask pipeline line-buffered so run-log
    # entries appear immediately — required for real-time forensic integrity.
    _rc_file="$(mktemp)"
    set +e
    # NOTE: the action runs as a background job so INT/TERM interrupt the wait
    # promptly and get audited. Caveat: on signal we audit exit 130/143 and
    # exit; the backgrounded backend is NOT reaped, so an interrupted
    # destructive op may still complete after guard records "interrupted".
    # (Killing a half-applied destructive mid-flight is its own hazard; the
    # forensic record is intentionally accurate that an interrupt was received.)
    # 추가 caveat (태스크 폴링 도입 이후): mutating verb 는 pve_wait_task 가
    # HOMELAB_TASK_TIMEOUT (기본 600s) 동안 PVE 태스크를 폴링하므로, 인터럽트
    # 시 고아 백엔드 프로세스가 최대 ~600s 계속 실행될 수 있음. _finish_trap 이
    # 감사 전 run-log 에서 task id 복구를 시도한다(우선순위 1: HO-TASK 라인,
    # 2: raw {"data":"UPID:..."}(PVE), 3: raw {"data":"<id>"}(PDM 등)) —
    # 인터럽트 시점에 task id 가 아직 run-log
    # 에 안 쓰였으면 task_upid 는 null 로 감사됨(발행 UPID 는 그 경우에도 이후
    # run-log 에서 사후 확인 가능; 포렌식 무결성 유지).
    {
      "$backend" "$action" "$target" -- ${extra[@]+"${extra[@]}"} 2>&1
      printf '%s\n' "$?" > "$_rc_file"
    } | sed -uE \
        -e '/-----BEGIN [A-Z ]*PRIVATE KEY-----/,/-----END [A-Z ]*PRIVATE KEY-----/{ s/.*/***MASKED-PRIVATE-KEY***/ }' \
        -e 's/(BW_SESSION=)[^[:space:]]+/\1***MASKED***/g' \
        -e 's/((PVE_TOKEN|PDM_TOKEN|HL_SSH_KEY|HL_SSH_PASS|HL_KUBECONFIG|SSHPASS)=)[^[:space:]]+/\1***MASKED***/g' \
        -e 's/(Authorization:[[:space:]]*[A-Za-z]+[[:space:]]+)[^[:space:]]+/\1***MASKED***/gI' \
        -e 's/(("?)(token|password|secret|api[_-]?token)("?)[[:space:]]*[:=][[:space:]]*"?)[^",[:space:]]+/\1***MASKED***/gI' \
        -e 's/(PVEAPIToken[^=]*=)[^[:space:]]+/\1***MASKED***/g' \
        -e 's/[A-Za-z0-9+\/]{40,}={0,2}/***MASKED-BLOB***/g' | tee -a "$rl" &
    _pipe_pid=$!
    wait "$_pipe_pid" || true
    rc="$(cat "$_rc_file" 2>/dev/null || echo 1)"
    rm -f "$_rc_file"
    set -e

    # Parse HO-TASK from the run-log rather than capturing backend stdout directly:
    # the action runs inside the background mask pipeline (… | sed -u | tee "$rl" &),
    # so $rl is the only place the structured HO-TASK line is available post-hoc.
    task_upid="$(sed -n 's/^HO-TASK upid=\([^ ]*\).*/\1/p' "$rl" 2>/dev/null | tail -n1 || true)"
    task_xs="$(sed -n 's/^HO-TASK .*exitstatus=\(.*\)$/\1/p' "$rl" 2>/dev/null | tail -n1 || true)"

    _DONE=1
    _audit "$rc" || echo "homelab-ops: AUDIT FAILED op=$op rc=$rc" >&2
    trap - EXIT INT TERM
    exit "$rc" ;;
esac
