#!/usr/bin/env bash
# Validate the key stream WITHOUT persisting it (still never written to disk):
# real ssh-add requires a PEM/OpenSSH key terminated by a newline. Reject a
# missing trailing newline (printf '%s') or a non-key blob so the regression is
# actually caught instead of silently "succeeding".
in="$(cat; echo X)"; in="${in%X}"
[[ "$in" == *$'\n' ]] || { echo "ssh-add stub: key not newline-terminated" >&2; exit 1; }
case "$in" in
  *"-----BEGIN "*"PRIVATE KEY-----"*"-----END "*"PRIVATE KEY-----"*) ;;
  *) echo "ssh-add stub: no BEGIN/END PRIVATE KEY block" >&2; exit 1 ;;
esac
echo "Identity added (stub)" >&2
