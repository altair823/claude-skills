#!/usr/bin/env bash
# Phase-1 provisioning backend. Stable interface; backend swappable in Phase 2.
# Usage: phase1 {dry-run|apply} <proxmox-host-id> --from-template <vmid> --new-vmid <vmid> [--name <n>]
# bin/_backend translates guard's dry-run probe into the literal `dry-run`
# subcommand and a real run into `apply`; phase1 never sees a bare --dry-run
# as its mode (the in-loop --dry-run case is only defensive for stray extras).
source "$(dirname "$0")/../bin/_lib.sh"
BIN="$REPO_ROOT/bin"

mode="${1:-}"; target="${2:-}"; shift 2 || true

tmpl=""; newid=""; name=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) mode="dry-run"; shift ;;
    --from-template) tmpl="${2:?--from-template requires a value}"; shift 2 ;;
    --new-vmid) newid="${2:?--new-vmid requires a value}"; shift 2 ;;
    --name) name="${2:?--name requires a value}"; shift 2 ;;
    --) shift ;;
    *) shift ;;
  esac
done
[[ -n "$target" ]] || die "usage: phase1 {dry-run|apply} <proxmox-host-id> --from-template <vmid> --new-vmid <vmid>"
[[ -n "$tmpl" && -n "$newid" ]] || die "phase1 requires --from-template and --new-vmid"

inv="$("$BIN/inv" get "$target")" || die "no such target: $target"
[[ "$(jq -r '.kind' <<<"$inv")" == "proxmox-host" ]] \
  || die "phase1: target '$target' is not a proxmox-host (provision runs on a Proxmox host)"
host="$(jq -r '.id' <<<"$inv")"
name="${name:-ho-${newid}}"

if [[ "$mode" == "dry-run" ]]; then
  echo "WOULD CREATE: clone template ${tmpl} -> vmid ${newid} (name=${name}) on host ${host}"
  echo "WOULD DESTROY: nothing"
  exit 0
fi
if [[ "$mode" == "apply" ]]; then
  # pve 의 `api` sub 는 _run_task 를 거치지 않으므로, phase1 이 직접 UPID 를
  # 캡처해 폴링한다. 로직은 bin/pve 의 _run_task 와 동일하다.
  resp="$("$BIN/pve" "$host" api POST "/nodes/${host}/qemu/${tmpl}/clone" "newid=${newid}&name=${name}")" \
    || die "clone API call failed"
  upid="$(jq -r 'if (.data|type)=="string" then .data else empty end' <<<"$resp" 2>/dev/null || true)"
  [[ "$upid" == UPID:* ]] || die "clone did not return a task UPID (got: $(jq -c '.data // "null"' <<<"$resp" 2>/dev/null | head -c 120))"
  pve_wait_task "$host" "$upid" || die "clone task did not complete OK (vmid ${newid}); see HO-TASK line"
  echo "CREATED: vmid ${newid} (name=${name}) cloned from ${tmpl} on ${host}"
  exit 0
fi
die "unknown mode: $mode"
